<!-- Customer credit, collections, dunning and recurring invoices (mantle.account.CreditServices, CollectionServices and
    RecurringInvoiceServices): an organization's credit policy per customer and the decisions releasing credit holds;
    collection activities, payment promises and disputes; dunning levels, runs and notices; invoice-only schedules and
    their occurrences. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <!-- ========== Credit ========== -->
    <entity entity-name="CustomerCreditPolicy" package="mantle.account.billing" cache="never">
        <description>An organization's credit policy for a customer, or its default for customers without their own (no
            customerPartyId), as effective-dated rows with audit-logged fields: the limit on exposure in the policy currency,
            the most days an unpaid invoice may be overdue, and whether going over warns or holds the order. A change ends
            the row in effect and starts the next (CreditServices.store#Policy, store#Defaults).</description>
        <field name="customerCreditPolicyId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="customerPartyId" type="id" enable-audit-log="true"/>
        <field name="currencyUomId" type="id" enable-audit-log="true"/>
        <field name="creditLimit" type="currency-amount" enable-audit-log="true">
            <description>The most exposure allowed; empty for no amount limit.</description></field>
        <field name="overdueDaysLimit" type="number-integer" enable-audit-log="true">
            <description>The most days the oldest unpaid invoice may be past due; empty for no limit.</description></field>
        <field name="actionEnumId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Customer" related="mantle.party.Party">
            <key-map field-name="customerPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Currency" related="moqui.basic.Uom">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <relationship type="one" title="CreditPolicyAction" related="moqui.basic.Enumeration">
            <key-map field-name="actionEnumId" related="enumId"/></relationship>
        <index name="CUSTOMER_CREDIT_POLICY_KEY">
            <index-field name="organizationPartyId"/><index-field name="customerPartyId"/><index-field name="fromDate"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Credit Policy Action" enumTypeId="CreditPolicyAction"/>
            <moqui.basic.Enumeration enumId="CpaWarn" enumTypeId="CreditPolicyAction" sequenceNum="1" description="Warn"/>
            <moqui.basic.Enumeration enumId="CpaHold" enumTypeId="CreditPolicyAction" sequenceNum="2" description="Hold"/>
        </seed-data>
    </entity>
    <entity entity-name="CreditHoldDecision" package="mantle.account.billing" cache="never">
        <description>A credit manager's decision on an order held for credit: the order (and part), the decision, its reason,
            who decided and when, how long it stands, and the exposure and limit the decision was made on.</description>
        <field name="creditHoldDecisionId" type="id" is-pk="true"/>
        <field name="orderId" type="id"/>
        <field name="orderPartSeqId" type="id"/>
        <field name="orderHoldReasonId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="decisionEnumId" type="id"/>
        <field name="reason" type="text-medium"/>
        <field name="decidedByUserId" type="id"/>
        <field name="decidedDate" type="date-time"/>
        <field name="expireDate" type="date-time"/>
        <field name="exposureAmount" type="currency-amount"/>
        <field name="creditLimit" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <relationship type="one" related="mantle.order.OrderHeader"/>
        <relationship type="one" related="mantle.order.OrderHoldReason"/>
        <relationship type="one" title="CreditDecision" related="moqui.basic.Enumeration">
            <key-map field-name="decisionEnumId" related="enumId"/></relationship>
        <index name="CREDIT_HOLD_DECISION_CUSTOMER">
            <index-field name="organizationPartyId"/><index-field name="customerPartyId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Credit Decision" enumTypeId="CreditDecision"/>
            <moqui.basic.Enumeration enumId="CrdRelease" enumTypeId="CreditDecision" sequenceNum="1" description="Released"/>
        </seed-data>
    </entity>

    <!-- ========== Collections ========== -->
    <entity entity-name="CollectionActivity" package="mantle.account.invoice" cache="never">
        <description>A collection contact or next action of an organization with a customer. The activity itself is a
            WorkEffort (a call, email or to-do, linked to the customer by WorkEffortRecord, so it shows on the customer's
            record and in the collector's Today); this row adds the organization and the outcome.</description>
        <field name="workEffortId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="outcomeEnumId" type="id"/>
        <field name="invoiceIds" type="text-long"><description>The invoices it is about, comma separated.</description></field>
        <relationship type="one" related="mantle.work.effort.WorkEffort"/>
        <relationship type="one" title="CollectionOutcome" related="moqui.basic.Enumeration">
            <key-map field-name="outcomeEnumId" related="enumId"/></relationship>
        <index name="COLLECTION_ACTIVITY_CUSTOMER">
            <index-field name="organizationPartyId"/><index-field name="customerPartyId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Collection Outcome" enumTypeId="CollectionOutcome"/>
            <moqui.basic.Enumeration enumId="CaoReached" enumTypeId="CollectionOutcome" sequenceNum="1"
                    description="Reached the customer"/>
            <moqui.basic.Enumeration enumId="CaoNoAnswer" enumTypeId="CollectionOutcome" sequenceNum="2" description="No answer"/>
            <moqui.basic.Enumeration enumId="CaoLeftMessage" enumTypeId="CollectionOutcome" sequenceNum="3"
                    description="Left a message"/>
            <moqui.basic.Enumeration enumId="CaoPromised" enumTypeId="CollectionOutcome" sequenceNum="4"
                    description="Promised to pay"/>
            <moqui.basic.Enumeration enumId="CaoDisputed" enumTypeId="CollectionOutcome" sequenceNum="5"
                    description="Disputed invoices"/>
            <moqui.basic.Enumeration enumId="CaoDisputeResolved" enumTypeId="CollectionOutcome" sequenceNum="6"
                    description="Dispute resolved"/>
            <moqui.basic.Enumeration enumId="CaoNextAction" enumTypeId="CollectionOutcome" sequenceNum="9"
                    description="Next action"/>
        </seed-data>
    </entity>
    <entity entity-name="CollectionPromise" package="mantle.account.invoice" cache="never">
        <description>A customer's promise to pay an organization an amount by a date, with the invoices it covers. It is
            kept when the customer's payments received from its date through the promised day reach the amount, and broken
            when the day passes first; it never marks an invoice paid.</description>
        <field name="collectionPromiseId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="customerPartyId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="amount" type="currency-amount" enable-audit-log="true"/>
        <field name="promisedDate" type="date" enable-audit-log="true"/>
        <field name="invoiceIds" type="text-long"><description>The invoices it covers, comma separated.</description></field>
        <field name="note" type="text-medium"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="workEffortId" type="id"><description>The collection activity that recorded it.</description></field>
        <relationship type="one" title="CollectionPromise" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <relationship type="one" title="Currency" related="moqui.basic.Uom">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <index name="COLLECTION_PROMISE_CUSTOMER">
            <index-field name="organizationPartyId"/><index-field name="customerPartyId"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Collection Promise" statusTypeId="CollectionPromise"/>
            <moqui.basic.StatusItem statusId="CprOpen" statusTypeId="CollectionPromise" sequenceNum="1" description="Open"/>
            <moqui.basic.StatusItem statusId="CprCancelled" statusTypeId="CollectionPromise" sequenceNum="9"
                    description="Cancelled"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CprOpen" toStatusId="CprCancelled"
                    transitionName="Cancel"/>
        </seed-data>
    </entity>
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="disputedDate" type="date-time" enable-audit-log="true">
            <description>When the customer disputed the invoice; a disputed invoice is left out of dunning until the dispute
                is resolved.</description></field>
        <field name="disputeNote" type="text-medium" enable-audit-log="true"/>
    </extend-entity>

    <!-- ========== Dunning ========== -->
    <entity entity-name="DunningLevel" package="mantle.account.invoice" cache="never">
        <description>A level of an organization's payment reminders, as effective-dated rows with audit-logged fields: from
            how many days overdue it applies, how many days must pass before the same customer gets this level again, the
            email template and whether disputed invoices are left out (CollectionServices.store#Level).</description>
        <field name="dunningLevelId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="daysOverdueFrom" type="number-integer" enable-audit-log="true"/>
        <field name="cadenceDays" type="number-integer" enable-audit-log="true"/>
        <field name="emailTemplateId" type="id" enable-audit-log="true"/>
        <field name="excludeDisputed" type="text-indicator" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id"/>
        <field name="previousLevelId" type="id"><description>The row this one replaced.</description></field>
        <relationship type="one" related="moqui.basic.email.EmailTemplate"/>
        <index name="DUNNING_LEVEL_ORG"><index-field name="organizationPartyId"/><index-field name="fromDate"/></index>
    </entity>
    <entity entity-name="DunningRun" package="mantle.account.invoice" cache="never">
        <description>A reminder run of an organization as of a day: its notices, previewed, then sent. Sending again sends
            only the notices not yet sent.</description>
        <field name="dunningRunId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="asOfDate" type="date"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="sentByUserId" type="id"/>
        <field name="sentDate" type="date-time"/>
        <field name="incomplete" type="text-indicator"><description>Y when more overdue invoices were found than one run
            takes.</description></field>
        <relationship type="one" title="DunningRun" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <relationship type="many" related="mantle.account.invoice.DunningNotice" short-alias="notices">
            <key-map field-name="dunningRunId"/></relationship>
        <index name="DUNNING_RUN_ORG"><index-field name="organizationPartyId"/><index-field name="createdDate"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Dunning Run" statusTypeId="DunningRun"/>
            <moqui.basic.StatusItem statusId="DrnPreview" statusTypeId="DunningRun" sequenceNum="1" description="Preview"/>
            <moqui.basic.StatusItem statusId="DrnPartial" statusTypeId="DunningRun" sequenceNum="2"
                    description="Partly sent"/>
            <moqui.basic.StatusItem statusId="DrnSent" statusTypeId="DunningRun" sequenceNum="3" description="Sent"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrnPreview" toStatusId="DrnPartial"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrnPreview" toStatusId="DrnSent"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DrnPartial" toStatusId="DrnSent"
                    transitionName="Send"/>
        </seed-data>
    </entity>
    <entity entity-name="DunningNotice" package="mantle.account.invoice" cache="never">
        <description>A reminder of a run: one customer, currency and level, the overdue invoices it names (invoiceIds) and
            their amount, its key (organization, customer, currency and level: a customer is not reminded at the same
            level again within the level's cadence), the recipients and the outcome of sending it. A row with status
            DntExcluded names invoices left out and why (disputed, held by a promise, covered by credits, sent
            recently).</description>
        <field name="dunningRunId" type="id" is-pk="true"/>
        <field name="noticeSeqId" type="id" is-pk="true"/>
        <field name="customerPartyId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="dunningLevelId" type="id"/>
        <field name="levelSequenceNum" type="number-integer"/>
        <field name="invoiceIds" type="text-long"/>
        <field name="overdueAmount" type="currency-amount"/>
        <field name="oldestDueDate" type="date"/>
        <field name="noticeKey" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="excludedReason" type="text-medium"/>
        <field name="toAddresses" type="text-medium"/>
        <field name="emailMessageId" type="id"/>
        <field name="errorMessage" type="text-medium"/>
        <field name="sentDate" type="date-time"/>
        <relationship type="one" related="mantle.account.invoice.DunningRun"/>
        <relationship type="one" related="mantle.account.invoice.DunningLevel"/>
        <relationship type="one" title="DunningNotice" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <index name="DUNNING_NOTICE_KEY"><index-field name="noticeKey"/><index-field name="statusId"/></index>
        <index name="DUNNING_NOTICE_CUSTOMER"><index-field name="customerPartyId"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Dunning Notice" statusTypeId="DunningNotice"/>
            <moqui.basic.StatusItem statusId="DntPending" statusTypeId="DunningNotice" sequenceNum="1" description="To send"/>
            <moqui.basic.StatusItem statusId="DntSent" statusTypeId="DunningNotice" sequenceNum="2" description="Sent"/>
            <moqui.basic.StatusItem statusId="DntFailed" statusTypeId="DunningNotice" sequenceNum="3" description="Failed"/>
            <moqui.basic.StatusItem statusId="DntExcluded" statusTypeId="DunningNotice" sequenceNum="4"
                    description="Left out"/>
            <!-- marked before its email is sent, in a transaction of its own, so a retry never sends it again; a notice
                left sending is checked by hand -->
            <moqui.basic.StatusItem statusId="DntSending" statusTypeId="DunningNotice" sequenceNum="5" description="Sending"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntPending" toStatusId="DntSent"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntPending" toStatusId="DntFailed"
                    transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntPending" toStatusId="DntExcluded"
                    transitionName="Leave out"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntFailed" toStatusId="DntSent"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntFailed" toStatusId="DntExcluded"
                    transitionName="Leave out"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntPending" toStatusId="DntSending"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntFailed" toStatusId="DntSending"
                    transitionName="Send"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntSending" toStatusId="DntSent"
                    transitionName="Sent"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntSending" toStatusId="DntFailed"
                    transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DntSending" toStatusId="DntExcluded"
                    transitionName="Leave out"/>
        </seed-data>
    </entity>
    <!-- The overdue receivables of an organization by customer and currency, summed in the query (Collections) -->
    <view-entity entity-name="CollectionOverdueSummary" package="mantle.account.invoice">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="dueDate"/>
        <alias entity-alias="INV" name="unpaidTotal"/>
        <alias entity-alias="INV" name="overdueTotal" field="unpaidTotal" function="sum"/>
        <alias entity-alias="INV" name="oldestDueDate" field="dueDate" function="min"/>
        <alias entity-alias="INV" name="invoiceCount" field="invoiceId" function="count" type="number-integer"/>
    </view-entity>

    <!-- An application with the invoice it pays when it is applied to an invoice from another (a credit memo applied with
        toInvoiceId), for the aging as of a day (LedgerReportServices.run#Aging) -->
    <view-entity entity-name="PaymentApplicationToInvoice" package="mantle.account.payment">
        <member-entity entity-alias="PAPP" entity-name="mantle.account.payment.PaymentApplication"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="PAPP">
            <key-map field-name="toInvoiceId" related="invoiceId"/></member-entity>
        <alias entity-alias="INV" name="invoiceId"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="PAPP" name="appliedDate"/>
    </view-entity>

    <!-- The credit exposure's parts, summed in the query (CreditServices): open order parts, what was billed of them,
        and payments -->
    <view-entity entity-name="CreditOpenOrderSum" package="mantle.order">
        <member-entity entity-alias="OPRT" entity-name="mantle.order.OrderPart"/>
        <member-entity entity-alias="ORHD" entity-name="mantle.order.OrderHeader" join-from-alias="OPRT">
            <key-map field-name="orderId"/></member-entity>
        <alias entity-alias="OPRT" name="vendorPartyId"/>
        <alias entity-alias="OPRT" name="customerPartyId"/>
        <alias entity-alias="OPRT" name="partStatusId" field="statusId"/>
        <alias entity-alias="ORHD" name="currencyUomId"/>
        <alias entity-alias="OPRT" name="partTotalSum" field="partTotal" function="sum"/>
    </view-entity>
    <view-entity entity-name="CreditOrderBillingSum" package="mantle.order">
        <member-entity entity-alias="OIB" entity-name="mantle.order.OrderItemBilling"/>
        <member-entity entity-alias="OITM" entity-name="mantle.order.OrderItem" join-from-alias="OIB">
            <key-map field-name="orderId"/><key-map field-name="orderItemSeqId"/></member-entity>
        <member-entity entity-alias="OPRT" entity-name="mantle.order.OrderPart" join-from-alias="OITM">
            <key-map field-name="orderId"/><key-map field-name="orderPartSeqId"/></member-entity>
        <member-entity entity-alias="ORHD" entity-name="mantle.order.OrderHeader" join-from-alias="OPRT">
            <key-map field-name="orderId"/></member-entity>
        <alias entity-alias="OPRT" name="vendorPartyId"/>
        <alias entity-alias="OPRT" name="customerPartyId"/>
        <alias entity-alias="OPRT" name="partStatusId" field="statusId"/>
        <alias entity-alias="ORHD" name="currencyUomId"/>
        <alias name="billedSum" function="sum" type="number-decimal"><complex-alias operator="*">
            <complex-alias-field entity-alias="OIB" field="quantity" default-value="1"/>
            <complex-alias-field entity-alias="OIB" field="amount" default-value="0"/>
        </complex-alias></alias>
    </view-entity>
    <view-entity entity-name="CreditOrderPaymentSum" package="mantle.account.payment">
        <member-entity entity-alias="PMT" entity-name="mantle.account.payment.Payment"/>
        <member-entity entity-alias="ORHD" entity-name="mantle.order.OrderHeader" join-from-alias="PMT">
            <key-map field-name="orderId"/></member-entity>
        <alias entity-alias="PMT" name="fromPartyId"/>
        <alias entity-alias="PMT" name="toPartyId"/>
        <alias entity-alias="PMT" name="amountUomId"/>
        <alias entity-alias="PMT" name="statusId"/>
        <alias entity-alias="ORHD" name="orderStatusId" field="statusId"/>
        <alias entity-alias="PMT" name="amountSum" field="amount" function="sum"/>
    </view-entity>
    <view-entity entity-name="CreditPaymentSum" package="mantle.account.payment">
        <member-entity entity-alias="PMT" entity-name="mantle.account.payment.Payment"/>
        <alias entity-alias="PMT" name="fromPartyId"/>
        <alias entity-alias="PMT" name="toPartyId"/>
        <alias entity-alias="PMT" name="amountUomId"/>
        <alias entity-alias="PMT" name="statusId"/>
        <alias entity-alias="PMT" name="orderId"/>
        <alias entity-alias="PMT" name="unappliedTotal"/>
        <alias entity-alias="PMT" name="amountSum" field="amount" function="sum"/>
        <alias entity-alias="PMT" name="unappliedSum" field="unappliedTotal" function="sum"/>
    </view-entity>

    <!-- ========== Recurring invoices ========== -->
    <entity entity-name="InvoiceSchedule" package="mantle.account.invoice" cache="never">
        <description>An invoice-only cadence (rent, a retainer, a recurring supplier bill): the template invoice whose lines
            each occurrence copies into a new draft, the interval, the first and last days and the next day due. A change
            applies to the occurrences not yet made; each made occurrence keeps its invoice. Order-based recurring billing
            stays on the order (OrderHeader.recurCronExpression and the create_RecurringOrders job).</description>
        <field name="invoiceScheduleId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="partyId" type="id" enable-audit-log="true"><description>The customer, or the supplier of a recurring
            bill.</description></field>
        <field name="templateInvoiceId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="intervalUomId" type="id" enable-audit-log="true"><description>TF_wk, TF_mon or TF_yr.</description></field>
        <field name="intervalQuantity" type="number-integer" enable-audit-log="true"/>
        <field name="startDate" type="date" enable-audit-log="true"/>
        <field name="endDate" type="date" enable-audit-log="true"/>
        <field name="nextDate" type="date"><description>The day of the next occurrence to make.</description></field>
        <field name="settlementTermId" type="id" enable-audit-log="true"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" title="Template" related="mantle.account.invoice.Invoice">
            <key-map field-name="templateInvoiceId" related="invoiceId"/></relationship>
        <relationship type="one" title="Interval" related="moqui.basic.Uom">
            <key-map field-name="intervalUomId" related="uomId"/></relationship>
        <relationship type="one" related="mantle.account.invoice.SettlementTerm"/>
        <relationship type="one" title="InvoiceSchedule" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <index name="INVOICE_SCHEDULE_DUE"><index-field name="statusId"/><index-field name="nextDate"/></index>
        <index name="INVOICE_SCHEDULE_ORG"><index-field name="organizationPartyId"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Invoice Schedule" statusTypeId="InvoiceSchedule"/>
            <moqui.basic.StatusItem statusId="IschActive" statusTypeId="InvoiceSchedule" sequenceNum="1" description="Active"/>
            <moqui.basic.StatusItem statusId="IschPaused" statusTypeId="InvoiceSchedule" sequenceNum="2" description="Paused"/>
            <moqui.basic.StatusItem statusId="IschEnded" statusTypeId="InvoiceSchedule" sequenceNum="3" description="Ended"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="IschActive" toStatusId="IschPaused"
                    transitionName="Pause"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="IschPaused" toStatusId="IschActive"
                    transitionName="Resume"/>
