<!-- Inventory valuation and landed costs (mantle.ledger.AssetBookServices preview#/post#LandedCost,
    mantle.product.InventoryReportServices run#InventoryValuation), and the scrap account of a count variance. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="LandedCostAllocation" package="mantle.account.invoice" cache="never">
        <description>One receipt line's share of a landed cost charge (a freight, duty or broker line of a bill), posted
            by post#LandedCost: the share of the receipt's stock still on hand raised that asset's cost, the share
            already issued went to cost of goods sold or production variance, and the charge account was credited. A
            charge line is allocated once (LcaPosted); its rows keep the basis and amounts it was allocated by.</description>
        <field name="landedCostAllocationId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceItemSeqId" type="id"/>
        <field name="assetReceiptId" type="id"/>
        <field name="assetId" type="id"/>
        <field name="shipmentId" type="id"/>
        <field name="productId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="basisEnumId" type="id"/>
        <field name="basisValue" type="number-decimal"><description>The receipt line's measure in the basis: its
            accepted quantity, value, weight or volume</description></field>
        <field name="amount" type="currency-amount"/>
        <field name="onHandQuantity" type="number-decimal"/>
        <field name="issuedQuantity" type="number-decimal"/>
        <field name="onHandAmount" type="currency-amount"/>
        <field name="issuedAmount" type="currency-amount"/>
        <field name="amountUomId" type="id"/>
        <field name="previousUnitCost" type="currency-precise"/>
        <field name="newUnitCost" type="currency-precise"/>
        <field name="assetGlAccountId" type="id"/>
        <field name="issuedGlAccountId" type="id"/>
        <field name="chargeGlAccountId" type="id"/>
        <field name="accountingDate" type="date"/>
        <field name="acctgTransId" type="id"/>
        <field name="operationKey" type="id"/>
        <field name="postedByUserId" type="id"/>
        <field name="postedDate" type="date-time"/>
        <field name="changeReason" type="text-medium"/>
        <relationship type="one" related="mantle.account.invoice.InvoiceItem"/>
        <relationship type="one" related="mantle.product.receipt.AssetReceipt"/>
        <relationship type="one" related="mantle.product.asset.Asset"/>
        <relationship type="one" related="mantle.ledger.transaction.AcctgTrans"/>
        <relationship type="one" title="LandedCostBasis" related="moqui.basic.Enumeration">
            <key-map field-name="basisEnumId"/></relationship>
        <relationship type="one" title="LandedCostAllocation" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <index name="LCA_INVOICE_ITEM"><index-field name="invoiceId"/><index-field name="invoiceItemSeqId"/></index>
        <index name="LCA_RECEIPT"><index-field name="assetReceiptId"/></index>
    </entity>

    <!-- Stock movements with their asset's owner, type, facility and cost, and the product's name: the valuation
        exceptions, the stock transactions report and the receipts a landed cost goes to -->
    <view-entity entity-name="AssetReceiptValuation" package="mantle.product.receipt">
        <member-entity entity-alias="ARCT" entity-name="mantle.product.receipt.AssetReceipt"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ARCT">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="ARCT" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ARCT"/>
        <alias entity-alias="AST" name="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="AST" name="acquireCost"/>
        <alias entity-alias="AST" name="acquireCostUomId"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>
    <view-entity entity-name="AssetIssuanceValuation" package="mantle.product.issuance">
        <member-entity entity-alias="AISS" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="AISS">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="AISS" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="AISS"><exclude field="facilityId"/></alias-all>
        <alias entity-alias="AST" name="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="AST" name="acquireCost"/>
        <alias entity-alias="AST" name="acquireCostUomId"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>
    <view-entity entity-name="AssetVarianceValuation" package="mantle.product.asset">
        <member-entity entity-alias="ASD" entity-name="mantle.product.asset.AssetDetail"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASD">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="AST" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ASD"><exclude field="productId"/></alias-all>
        <alias entity-alias="AST" name="productId"/>
        <alias entity-alias="AST" name="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="AST" name="acquireCost"/>
        <alias entity-alias="AST" name="acquireCostUomId"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <extend-entity entity-name="AssetTypeGlAccount" package="mantle.ledger.config">
        <field name="scrapGlAccountId" type="id"><description>The debit account of a count variance with a scrap reason
            (an InventoryVarianceReason with enumCode scrap) when the organization has no VarianceReasonGlAccount row
            for the reason</description></field>
        <relationship type="one" title="Scrap" related="mantle.ledger.account.GlAccount">
            <key-map field-name="scrapGlAccountId"/></relationship>
    </extend-entity>
</entities>
