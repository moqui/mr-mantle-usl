<!-- A changed receipt or bill line marks the applied matches it touches stale; the re-evaluation job evaluates them. These
    only queue: an indexed read of the match lines, and a write only when a match is found. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="AssetReceiptQueueMatchReevaluation" entity="mantle.product.receipt.AssetReceipt"
            on-create="true" on-update="true" on-delete="true" run-on-error="false" get-entire-entity="true"
            get-original-value="true">
        <description>A purchase receipt created, removed, or changed in its accepted quantity, order line or asset: queue the
            matches of its order line. A write of only its invoice (a bill or a match linking it) queues nothing.</description>
        <condition><expression>orderId &amp;&amp; orderItemSeqId &amp;&amp; (eecaOperation != 'update' || originalValue == null
            || toDecimal(quantityAccepted ?? 0).compare(toDecimal(originalValue.quantityAccepted ?? 0)) != 0
            || orderId != originalValue.orderId || orderItemSeqId != originalValue.orderItemSeqId
            || assetId != originalValue.assetId)</expression></condition>
        <actions>
            <service-call name="mantle.account.InvoiceMatchServices.queue#MatchReevaluation" disable-authz="true"
                    in-map="{assetReceiptId:assetReceiptId, orderId:orderId, orderItemSeqId:orderItemSeqId,
                        staleReason:'Receipt ' + assetReceiptId + ' changed'}"/>
        </actions>
    </eeca>
    <eeca id="InvoiceItemQueueMatchReevaluation" entity="mantle.account.invoice.InvoiceItem"
            on-create="true" on-update="true" on-delete="true" run-on-error="false">
        <description>A bill line added, changed or removed: queue the bill's applied match.</description>
        <actions>
            <service-call name="mantle.account.InvoiceMatchServices.queue#MatchReevaluation" disable-authz="true"
                    in-map="{invoiceId:invoiceId, staleReason:'Bill line ' + invoiceItemSeqId + ' changed'}"/>
        </actions>
    </eeca>
</eecas>
