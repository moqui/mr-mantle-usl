<!-- Budget control (AC-14): the organization's control policy rows, the commitments its spending reserves against a budget
    and converts to actual, and the stored PDFs of an approved budget's revisions. mantle.other.BudgetServices writes
    them. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="BudgetControlPolicy" package="mantle.other.budget" cache="never">
        <description>How an organization controls spending against its budgets, as effective-dated rows: a change ends the
            row in effect and starts the next (store#Policy). A row for a budget and account wins over one for the account,
            which wins over one for the budget, which wins over the organization's; a row for one stage wins over one for
            every stage. With no row in effect spending is not controlled (Ignore).</description>
        <field name="budgetControlPolicyId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="budgetId" type="id" enable-audit-log="true"/>
        <field name="glAccountId" type="id" enable-audit-log="true"/>
        <field name="stageEnumId" type="id" enable-audit-log="true">
            <description>The stage it controls (BudgetControlStage); empty for every stage.</description></field>
        <field name="actionEnumId" type="id" enable-audit-log="true">
            <description>BcaIgnore, BcaWarn or BcaStop when the spending would pass the threshold.</description></field>
        <field name="thresholdPercent" type="number-decimal" enable-audit-log="true">
            <description>The percent of the budget amount spending may reach (100 when empty).</description></field>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="description" type="text-medium"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.other.budget.Budget"/>
        <relationship type="one" related="mantle.ledger.account.GlAccount"/>
        <relationship type="one" title="BudgetControlStage" related="moqui.basic.Enumeration">
            <key-map field-name="stageEnumId" related="enumId"/></relationship>
        <relationship type="one" title="BudgetControlAction" related="moqui.basic.Enumeration">
            <key-map field-name="actionEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Budget Control Stage" enumTypeId="BudgetControlStage"/>
            <moqui.basic.Enumeration description="Request" enumId="BcsRequest" enumTypeId="BudgetControlStage"
                    sequenceNum="1"/>
            <moqui.basic.Enumeration description="Purchase order" enumId="BcsOrder" enumTypeId="BudgetControlStage"
                    sequenceNum="2"/>
            <moqui.basic.Enumeration description="Expense" enumId="BcsExpense" enumTypeId="BudgetControlStage"
                    sequenceNum="3"/>
            <moqui.basic.EnumerationType description="Budget Control Action" enumTypeId="BudgetControlAction"/>
            <moqui.basic.Enumeration description="Ignore" enumId="BcaIgnore" enumTypeId="BudgetControlAction"
                    sequenceNum="1"/>
            <moqui.basic.Enumeration description="Warn" enumId="BcaWarn" enumTypeId="BudgetControlAction" sequenceNum="2"/>
            <moqui.basic.Enumeration description="Stop" enumId="BcaStop" enumTypeId="BudgetControlAction" sequenceNum="3"/>
        </seed-data>
        <index name="BUDGET_CTRL_POLICY_ORG"><index-field name="organizationPartyId"/><index-field name="fromDate"/></index>
    </entity>

    <entity entity-name="BudgetCommitment" package="mantle.other.budget" cache="never">
        <description>Spending of a source document line held against a budget: a request or purchase order line reserves
            (BcReserved), a later stage converts it (a new commitment whose convertedFromId names it: BcConverted once its
            amount is used up), a bill line records the actual (BcActual) and a close or cancel releases what is left
            (BcReleased); a bill whose approval is undone reverses its actuals (BcReversed). A refused Stop is kept as
            BcBlocked with the decision, for the exceptions list. Each is keyed by its source line, revision and stage, so
            a retry answers the first. Its relationships carry no foreign keys: a refused Stop is recorded in its own
            transaction while the caller holds its locks.</description>
        <field name="budgetCommitmentId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="budgetId" type="id"/>
        <field name="budgetItemSeqId" type="id"/>
        <field name="glAccountId" type="id"/>
        <field name="timePeriodId" type="id"><description>The budget period (or sub period) the commitment was checked
            against.</description></field>
        <field name="commitmentDate" type="date"><description>The book day of the spending, which places it in a
            period.</description></field>
        <field name="sourceEntityName" type="text-medium"/>
        <field name="sourceId" type="id"/>
        <field name="sourceItemId" type="id"/>
        <field name="sourceRevision" type="text-medium"/>
        <field name="stageEnumId" type="id"/>
        <field name="amount" type="currency-amount" enable-audit-log="update"/>
        <field name="currencyUomId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="convertedFromId" type="id"/>
        <field name="budgetControlPolicyId" type="id"/>
        <field name="decisionEnumId" type="id"><description>BcdWithin, BcdNoControl, BcdWarned, BcdOverridden or
            BcdBlocked.</description></field>
        <field name="budgetAmount" type="currency-amount"><description>At the decision: the budget amount, what was
            spent and committed before it, and what was left.</description></field>
        <field name="spentAmount" type="currency-amount"/>
        <field name="availableAmount" type="currency-amount"/>
        <field name="decisionMessage" type="text-medium"/>
        <field name="overrideReason" type="text-medium"/>
        <field name="overrideByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="createdByUserId" type="id"/>
        <field name="releasedDate" type="date-time"/>
        <relationship type="one-nofk" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one-nofk" related="mantle.other.budget.Budget"/>
        <relationship type="one-nofk" related="mantle.other.budget.BudgetItem"/>
        <relationship type="one-nofk" related="mantle.ledger.account.GlAccount"/>
        <relationship type="one-nofk" related="mantle.party.time.TimePeriod"/>
        <relationship type="one-nofk" title="ConvertedFrom" related="mantle.other.budget.BudgetCommitment">
            <key-map field-name="convertedFromId" related="budgetCommitmentId"/></relationship>
        <relationship type="one-nofk" related="mantle.other.budget.BudgetControlPolicy"/>
        <relationship type="one" title="BudgetCommitment" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <relationship type="one" title="BudgetControlStage" related="moqui.basic.Enumeration">
            <key-map field-name="stageEnumId" related="enumId"/></relationship>
        <relationship type="one" title="BudgetCommitmentDecision" related="moqui.basic.Enumeration">
            <key-map field-name="decisionEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.StatusType description="Budget Commitment" statusTypeId="BudgetCommitment"/>
            <moqui.basic.StatusItem statusId="BcReserved" statusTypeId="BudgetCommitment" description="Reserved"
                    sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="BcConverted" statusTypeId="BudgetCommitment" description="Converted"
                    sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="BcActual" statusTypeId="BudgetCommitment" description="Actual"
                    sequenceNum="3"/>
            <moqui.basic.StatusItem statusId="BcReleased" statusTypeId="BudgetCommitment" description="Released"
                    sequenceNum="4"/>
            <moqui.basic.StatusItem statusId="BcBlocked" statusTypeId="BudgetCommitment" description="Blocked"
                    sequenceNum="5"/>
            <moqui.basic.StatusItem statusId="BcReversed" statusTypeId="BudgetCommitment" description="Reversed"
                    sequenceNum="6"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BcReserved" toStatusId="BcConverted"
                    transitionName="Convert"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BcReserved" toStatusId="BcReleased"
                    transitionName="Release"/>
            <!-- a bill whose approval is undone or which is cancelled reverses its actuals, and the order's share is open
                again -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BcActual" toStatusId="BcReversed"
                    transitionName="Reverse"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BcConverted" toStatusId="BcReserved"
                    transitionName="Reopen"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BcReleased" toStatusId="BcReversed"
                    transitionName="Reverse"/>
            <moqui.basic.EnumerationType description="Budget Commitment Decision" enumTypeId="BudgetCommitmentDecision"/>
            <moqui.basic.Enumeration description="Within budget" enumId="BcdWithin" enumTypeId="BudgetCommitmentDecision"
                    sequenceNum="1"/>
            <moqui.basic.Enumeration description="Not controlled" enumId="BcdNoControl"
                    enumTypeId="BudgetCommitmentDecision" sequenceNum="2"/>
            <moqui.basic.Enumeration description="Over budget, warned" enumId="BcdWarned"
                    enumTypeId="BudgetCommitmentDecision" sequenceNum="3"/>
            <moqui.basic.Enumeration description="Over budget, overridden" enumId="BcdOverridden"
                    enumTypeId="BudgetCommitmentDecision" sequenceNum="4"/>
            <moqui.basic.Enumeration description="Over budget, stopped" enumId="BcdBlocked"
                    enumTypeId="BudgetCommitmentDecision" sequenceNum="5"/>
        </seed-data>
        <index name="BUDGET_COMMIT_SOURCE"><index-field name="sourceEntityName"/><index-field name="sourceId"/></index>
        <index name="BUDGET_COMMIT_ACCOUNT"><index-field name="organizationPartyId"/><index-field name="glAccountId"/>
            <index-field name="commitmentDate"/></index>
        <index name="BUDGET_COMMIT_FROM"><index-field name="convertedFromId"/></index>
    </entity>

    <entity entity-name="BudgetContent" package="mantle.other.budget" cache="never">
        <description>A file of a budget: the PDF of each approved revision (BctApprovedDocument), stored when it is approved
            or revised and never changed.</description>
        <field name="budgetContentId" type="id" is-pk="true"/>
        <field name="budgetId" type="id" not-null="true"/>
        <field name="revisionSeqId" type="id"/>
        <field name="contentTypeEnumId" type="id"/>
        <field name="contentLocation" type="text-medium"/>
        <field name="contentDate" type="date-time"/>
        <field name="userId" type="id"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="mantle.other.budget.Budget"/>
        <relationship type="one" title="BudgetContentType" related="moqui.basic.Enumeration">
            <key-map field-name="contentTypeEnumId" related="enumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Budget Content Type" enumTypeId="BudgetContentType"/>
            <moqui.basic.Enumeration description="Approved budget" enumId="BctApprovedDocument"
                    enumTypeId="BudgetContentType"/>
        </seed-data>
    </entity>
</entities>
