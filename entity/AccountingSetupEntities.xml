<!-- Accounting setup and activation (mantle.ledger.SetupServices store#SetupRun, preview#OpeningBalances,
    import#OpenItems, check#Readiness and activate#Accounting): an organization's one setup run, its opening trial
    balance and the open invoices and bills imported at cutover. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="AccountingSetupRun" package="mantle.ledger.config" cache="never">
        <description>An organization's accounting setup: the chart template it was set up from, the opening day, the
            migration clearing account the opening items and balances post against, and its version, which each change
            to its basis, balances or open items raises. Activation posts the opening balances once and records the
            transaction; an activated run is not changed again.</description>
        <field name="setupRunId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="sourcePartyId" type="id" enable-audit-log="true">
            <description>The chart template (a party with the OrgAccountingTemplate role) copied by
                init#PartyAccountingConfiguration, when the organization had no configuration of its own.</description>
        </field>
        <field name="openingDate" type="date" enable-audit-log="true"/>
        <field name="migrationGlAccountId" type="id" enable-audit-log="true"/>
        <field name="runVersion" type="number-integer" enable-audit-log="true"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="activatedAcctgTransId" type="id" enable-audit-log="true"/>
        <field name="activatedDate" type="date-time" enable-audit-log="true"/>
        <field name="activatedByUserId" type="id" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="Source" related="mantle.party.Party">
            <key-map field-name="sourcePartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="moqui.basic.StatusItem"/>
        <relationship type="one" title="Migration" related="mantle.ledger.account.GlAccount">
            <key-map field-name="migrationGlAccountId" related="glAccountId"/>
        </relationship>
        <relationship type="one" title="Activated" related="mantle.ledger.transaction.AcctgTrans">
            <key-map field-name="activatedAcctgTransId" related="acctgTransId"/>
        </relationship>
        <index name="ACCTG_SETUP_RUN_ORG" unique="true">
            <index-field name="organizationPartyId"/>
        </index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="AccountingSetupRun" description="Accounting setup run"/>
            <moqui.basic.StatusItem statusId="AsrDraft" statusTypeId="AccountingSetupRun" sequenceNum="1"
                    description="In setup"/>
            <moqui.basic.StatusItem statusId="AsrActivated" statusTypeId="AccountingSetupRun" sequenceNum="2"
                    description="Activated"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="AsrDraft" toStatusId="AsrActivated"
                    transitionName="Activate"/>
        </seed-data>
    </entity>
    <entity entity-name="AccountingSetupBalance" package="mantle.ledger.config" cache="never">
        <description>A line of a setup run's opening trial balance: an account's debit or credit balance on the opening
            day, in the base currency. A line on a receivable or payable control account is carried by the open items,
            and activation posts it against the migration clearing account.</description>
        <field name="setupRunId" type="id" is-pk="true"/>
        <field name="glAccountId" type="id" is-pk="true"/>
        <field name="debitAmount" type="currency-amount" enable-audit-log="true"/>
        <field name="creditAmount" type="currency-amount" enable-audit-log="true"/>
        <relationship type="one" related="mantle.ledger.config.AccountingSetupRun"/>
        <relationship type="one" related="mantle.ledger.account.GlAccount"/>
    </entity>
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="openingSetupRunId" type="id" enable-audit-log="true">
            <description>An open invoice or bill imported at cutover by import#OpenItems (the opening flag): issued at
                its own document and due dates, posted on the opening day against the migration clearing
                account.</description>
        </field>
        <relationship type="one" title="Opening" related="mantle.ledger.config.AccountingSetupRun">
            <key-map field-name="openingSetupRunId" related="setupRunId"/>
        </relationship>
        <index name="INVOICE_OPENING_RUN">
            <index-field name="openingSetupRunId"/>
        </index>
    </extend-entity>
</entities>
