<!-- Fixed asset books (mantle.ledger.AssetBookServices, logic in ledger/FixedAssets.js): an organization's book defaults by
    asset class, and the book facts of capitalization, adjustment, disposal, reversal and acquire cost repair on
    AssetBookEvent, which Products' revaluation began. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="FixedAssetClass" package="mantle.product.asset" cache="never">
        <description>An organization's book defaults for an asset class (the AssetClass enumeration, which named classes
            before and gave no defaults), as dated versions: AssetBookServices.store#Class ends the version in effect where
            the next starts. Capitalization adopts the version in effect on the in-service day; an asset keeps the basis it
            adopted when the class changes later.</description>
        <field name="fixedAssetClassId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="classEnumId" type="id"/>
        <field name="assetTypeEnumId" type="id"><description>The fixed asset type the class applies to</description></field>
        <field name="description" type="text-medium"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="usefulLifeYears" type="number-integer" enable-audit-log="true"/>
        <field name="salvagePercent" type="number-decimal" enable-audit-log="true">
            <description>The residual value as a percent of the acquire cost</description></field>
        <field name="depreciationTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="taxDepreciationTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="assetGlAccountId" type="id" enable-audit-log="true"/>
        <field name="accDepreciationGlAccountId" type="id" enable-audit-log="true"/>
        <field name="depreciationGlAccountId" type="id" enable-audit-log="true"/>
        <field name="gainGlAccountId" type="id" enable-audit-log="true">
            <description>The credit account of a gain on disposal</description></field>
        <field name="lossGlAccountId" type="id" enable-audit-log="true">
            <description>The debit account of a loss on disposal</description></field>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="AssetClass" related="moqui.basic.Enumeration" short-alias="class">
            <key-map field-name="classEnumId"/></relationship>
        <relationship type="one" title="AssetType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="assetTypeEnumId"/></relationship>
        <relationship type="one" title="DepreciationType" related="moqui.basic.Enumeration">
            <key-map field-name="depreciationTypeEnumId"/></relationship>
        <relationship type="one" title="TaxDepreciationType" related="moqui.basic.Enumeration">
            <key-map field-name="taxDepreciationTypeEnumId"/></relationship>
        <relationship type="one" title="Asset" related="mantle.ledger.account.GlAccount">
            <key-map field-name="assetGlAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="AccDepreciation" related="mantle.ledger.account.GlAccount">
            <key-map field-name="accDepreciationGlAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="Depreciation" related="mantle.ledger.account.GlAccount">
            <key-map field-name="depreciationGlAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="Gain" related="mantle.ledger.account.GlAccount">
            <key-map field-name="gainGlAccountId" related="glAccountId"/></relationship>
        <relationship type="one" title="Loss" related="mantle.ledger.account.GlAccount">
            <key-map field-name="lossGlAccountId" related="glAccountId"/></relationship>
        <index name="FA_CLASS_ORG"><index-field name="organizationPartyId"/><index-field name="classEnumId"/></index>
    </entity>
    <extend-entity entity-name="AssetBookEvent" package="mantle.product.asset">
        <field name="fixedAssetClassId" type="id" enable-audit-log="true"/>
        <field name="disposalTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="proceedsAmount" type="currency-amount" enable-audit-log="true"/>
        <field name="gainLossAmount" type="currency-amount" enable-audit-log="true">
            <description>A disposal's gain (positive) or loss (negative)</description></field>
        <field name="buyerPartyId" type="id" enable-audit-log="true"/>
        <field name="salesInvoiceId" type="id" enable-audit-log="true"/>
        <field name="sourceInvoiceId" type="id" enable-audit-log="true"/>
        <field name="sourceAssetReceiptId" type="id" enable-audit-log="true"/>
        <field name="bookBeforeJson" type="text-very-long">
            <description>The asset's book basis before the event, which its reversal restores</description></field>
        <field name="bookAfterJson" type="text-very-long"/>
        <relationship type="one" title="AssetBookEventType" related="moqui.basic.Enumeration" short-alias="eventType">
            <key-map field-name="eventTypeEnumId"/></relationship>
        <relationship type="one-nofk" related="mantle.product.asset.FixedAssetClass">
            <key-map field-name="fixedAssetClassId"/></relationship>
        <relationship type="one" title="AssetDisposalType" related="moqui.basic.Enumeration">
            <key-map field-name="disposalTypeEnumId"/></relationship>
        <relationship type="one-nofk" title="ReversalOf" related="mantle.product.asset.AssetBookEvent">
            <key-map field-name="reversalOfAssetBookEventId" related="assetBookEventId"/></relationship>
        <index name="ASSET_BOOK_EVT_ASSET"><index-field name="assetId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType enumTypeId="AssetDisposalType" description="Asset disposal type"/>
            <moqui.basic.Enumeration enumId="AdtScrap" enumTypeId="AssetDisposalType" description="Scrapped" sequenceNum="1"/>
            <moqui.basic.Enumeration enumId="AdtSale" enumTypeId="AssetDisposalType" description="Sold" sequenceNum="2"/>
        </seed-data>
    </extend-entity>
</entities>
