<!-- Payment terms and payment runs: a term's installment and early-payment discount lines, the due schedule an invoice
    keeps from its term when it is issued, and the supplier payment runs that pay due bills
    (mantle.ledger.SetupServices.store#SettlementTerm, mantle.account.PaymentRunServices). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="SettlementTermLine" package="mantle.account.invoice" cache="never">
        <description>One portion of a payment term, as effective-dated rows: a share of the invoice due a number of days
            after the invoice date, and an early-payment discount taken when paid within its days. A term without lines in
            effect is one portion due on its own date with no discount. A change ends the lines in effect and starts the
            next (store#SettlementTerm); an issued invoice keeps its own InvoiceDueSchedule.</description>
        <field name="settlementTermLineId" type="id" is-pk="true"/>
        <field name="settlementTermId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="portionPercent" type="number-decimal" enable-audit-log="true">
            <description>The share of the invoice total this line makes due; a term's lines in effect add up to
                100.</description></field>
        <field name="daysBasis" type="number-integer" enable-audit-log="true">
            <description>Days after the invoice date the portion is due.</description></field>
        <field name="discountPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="discountDays" type="number-integer" enable-audit-log="true">
            <description>Days after the invoice date within which the discount may be taken.</description></field>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id"/>
        <relationship type="one" related="mantle.account.invoice.SettlementTerm"/>
        <index name="SETTLEMENT_TERM_LINE_TERM"><index-field name="settlementTermId"/><index-field name="fromDate"/></index>
        <seed-data>
            <!-- the seeded discount terms, described in SettlementTerm's text, as lines -->
            <mantle.account.invoice.SettlementTermLine settlementTermLineId="Net30Disc2Pct10_1" settlementTermId="Net30Disc2Pct10"
                    sequenceNum="1" portionPercent="100" daysBasis="30" discountPercent="2" discountDays="10"
                    fromDate="2000-01-01 00:00:00.000"/>
            <mantle.account.invoice.SettlementTermLine settlementTermLineId="Net45Disc2Pct15_1" settlementTermId="Net45Disc2Pct15"
                    sequenceNum="1" portionPercent="100" daysBasis="45" discountPercent="2" discountDays="15"
                    fromDate="2000-01-01 00:00:00.000"/>
        </seed-data>
    </entity>
    <entity entity-name="InvoiceDueSchedule" package="mantle.account.invoice" cache="never">
        <description>What an issued invoice is due and when, written once when it is issued (finalized, or approved for a
            bill) from its term's lines in effect on the invoice date: each portion's due date and amount, and the discount
            and the last day it may be taken. A later change of the term never changes it. Aging, the workbenches, payment
            runs and apply#Settlement read it (InvoiceServices.get#InvoiceDueSchedule). Its rows are not audit-logged: they are
            written once at issue and removed only when the invoice goes back for changes (Resume Changes), both recorded
            in the invoice's own status audit log.</description>
        <field name="invoiceId" type="id" is-pk="true"/>
        <field name="scheduleSeqId" type="id" is-pk="true"/>
        <field name="dueDate" type="date"><description>A calendar day: the invoice's book day and the
            portion's days.</description></field>
        <field name="amount" type="currency-amount"/>
        <field name="discountDate" type="date">
            <description>The last calendar day the discount may be taken.</description></field>
        <field name="discountAmount" type="currency-amount"/>
        <field name="settlementTermId" type="id"/>
        <field name="settlementTermLineId" type="id"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" related="mantle.account.invoice.SettlementTerm"/>
        <relationship type="one-nofk" related="mantle.account.invoice.SettlementTermLine"/>
    </entity>

    <entity entity-name="PaymentRun" package="mantle.account.payment" cache="never">
        <description>A batch of supplier payments from one of the organization's bank accounts: the due approved bills
            selected (PaymentRunItem), approved as a whole (its approved total and the version of its selection), then
            executed, one payment per supplier, with the bank file of its payments. A change to a supplier's bank details
            voids a pending approval (void#RunApproval).</description>
        <field name="paymentRunId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentMethodId" type="id">
            <description>The organization's bank account the run pays from.</description></field>
        <field name="paymentInstrumentEnumId" type="id"><description>ACH (PiAch) or check (PiCompanyCheck).</description></field>
        <field name="currencyUomId" type="id"/>
        <field name="dueThroughDate" type="date"/>
        <field name="payDate" type="date"/>
        <field name="description" type="text-medium"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedTotal" type="currency-amount" enable-audit-log="true"/>
        <field name="approvedVersion" type="text-medium"><description>The fingerprint of the selection approved; execution
            refuses a selection that differs.</description></field>
        <field name="isSelfApproved" type="text-indicator" enable-audit-log="true"/>
        <field name="approvalVoidedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvalVoidReason" type="text-medium" enable-audit-log="true"/>
        <field name="executedByUserId" type="id"/>
        <field name="executedDate" type="date-time"/>
        <field name="executeOperationKey" type="id"><description>The claim of an execution in progress or done: the one key
            that may execute or resume the run; a completed execution is also a PostingOperation under the
            key.</description></field>
        <field name="executionMessage" type="text-medium"><description>Why an executed run is not finished yet (its bank file,
            or payments not yet applied); the same key resumes it.</description></field>
        <field name="paymentMethodFileId" type="id"><description>The bank file of the run's payments: NACHA for ACH,
            Positive Pay for checks when the bank account has a format.</description></field>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.account.method.PaymentMethod"/>
        <relationship type="one" title="PaymentInstrument" related="moqui.basic.Enumeration">
            <key-map field-name="paymentInstrumentEnumId" related="enumId"/></relationship>
        <relationship type="one" title="Currency" related="moqui.basic.Uom">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <relationship type="one" title="PaymentRun" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/></relationship>
        <relationship type="one" related="mantle.account.method.PaymentMethodFile"/>
        <relationship type="many" related="mantle.account.payment.PaymentRunItem" short-alias="items">
            <key-map field-name="paymentRunId"/></relationship>
        <index name="PAYMENT_RUN_ORG"><index-field name="organizationPartyId"/><index-field name="statusId"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Payment Run" statusTypeId="PaymentRun"/>
            <moqui.basic.StatusItem statusId="PrunDraft" statusTypeId="PaymentRun" sequenceNum="1" description="Proposed"/>
            <moqui.basic.StatusItem statusId="PrunApproved" statusTypeId="PaymentRun" sequenceNum="2" description="Approved"/>
            <moqui.basic.StatusItem statusId="PrunExecuted" statusTypeId="PaymentRun" sequenceNum="3" description="Executed"/>
            <moqui.basic.StatusItem statusId="PrunCancelled" statusTypeId="PaymentRun" sequenceNum="9" description="Cancelled"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrunDraft" toStatusId="PrunApproved"
                    transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrunDraft" toStatusId="PrunCancelled"
                    transitionName="Cancel"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrunApproved" toStatusId="PrunDraft"
                    transitionName="Void approval"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrunApproved" toStatusId="PrunExecuted"
                    transitionName="Execute"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrunApproved" toStatusId="PrunCancelled"
                    transitionName="Cancel"/>
        </seed-data>
    </entity>
    <entity entity-name="PaymentRunItem" package="mantle.account.payment" cache="never">
        <description>A bill of a payment run: what was open and due when it was selected, the discount within its date, the
            amount to pay and whether it is in the run, or why it is left out (a hold, no bank account, the user). At
            execution each supplier's selected items get one payment (paymentId), and the result of each.</description>
        <field name="paymentRunId" type="id" is-pk="true"/>
        <field name="paymentRunItemSeqId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="supplierPartyId" type="id"/>
        <field name="toPaymentMethodId" type="id">
            <description>The supplier's bank account when it was selected.</description></field>
        <field name="dueDate" type="date"/>
        <field name="discountDate" type="date"/>
        <field name="unpaidAmount" type="currency-amount"/>
        <field name="discountAmount" type="currency-amount"/>
        <field name="paymentAmount" type="currency-amount"/>
        <field name="selectedIndicator" type="text-indicator" enable-audit-log="true"/>
        <field name="excludeReasonEnumId" type="id" enable-audit-log="true"/>
        <field name="excludeComment" type="text-medium"/>
        <field name="paymentId" type="id"/>
        <field name="discountInvoiceId" type="id">
            <description>The prompt-payment discount credit applied to the bill.</description></field>
        <field name="resultEnumId" type="id"/>
        <field name="resultMessage" type="text-medium"/>
        <relationship type="one" related="mantle.account.payment.PaymentRun"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" title="Supplier" related="mantle.party.Party">
            <key-map field-name="supplierPartyId" related="partyId"/></relationship>
        <relationship type="one" title="To" related="mantle.account.method.PaymentMethod">
            <key-map field-name="toPaymentMethodId" related="paymentMethodId"/></relationship>
        <relationship type="one" related="mantle.account.payment.Payment"/>
        <relationship type="one" title="PaymentRunExclusion" related="moqui.basic.Enumeration">
            <key-map field-name="excludeReasonEnumId" related="enumId"/></relationship>
        <relationship type="one" title="PaymentRunResult" related="moqui.basic.Enumeration">
            <key-map field-name="resultEnumId" related="enumId"/></relationship>
        <index name="PAYMENT_RUN_ITEM_INVOICE"><index-field name="invoiceId"/></index>
        <index name="PAYMENT_RUN_ITEM_PAYMENT"><index-field name="paymentId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Payment Run Exclusion" enumTypeId="PaymentRunExclusion"/>
            <moqui.basic.Enumeration enumId="PrxHeld" enumTypeId="PaymentRunExclusion" sequenceNum="1" description="On hold"/>
            <moqui.basic.Enumeration enumId="PrxNoBankAccount" enumTypeId="PaymentRunExclusion" sequenceNum="2"
                    description="No bank account for ACH"/>
            <moqui.basic.Enumeration enumId="PrxInOtherRun" enumTypeId="PaymentRunExclusion" sequenceNum="3"
                    description="In another open run"/>
            <moqui.basic.Enumeration enumId="PrxUser" enumTypeId="PaymentRunExclusion" sequenceNum="4"
                    description="Left out by the user"/>
            <moqui.basic.EnumerationType description="Payment Run Result" enumTypeId="PaymentRunResult"/>
            <moqui.basic.Enumeration enumId="PrrPaid" enumTypeId="PaymentRunResult" sequenceNum="1" description="Paid"/>
            <moqui.basic.Enumeration enumId="PrrSent" enumTypeId="PaymentRunResult" sequenceNum="2"
                    description="Sent to the bank"/>
            <moqui.basic.Enumeration enumId="PrrFailed" enumTypeId="PaymentRunResult" sequenceNum="3" description="Failed"/>
            <moqui.basic.Enumeration enumId="PrrReturned" enumTypeId="PaymentRunResult" sequenceNum="4"
                    description="Returned by the bank"/>
        </seed-data>
    </entity>
</entities>
