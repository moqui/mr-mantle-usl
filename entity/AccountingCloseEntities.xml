<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="PartyAcctgPreference" package="mantle.ledger.config">
        <field name="projectCostPostingEnabled" type="text-indicator" default="'N'" enable-audit-log="update">
            <description>Post approved project time at its cost rate to project cost, from the labor clearing account
                (OtherAutoPostServices.post#WorkEffortCost, on timesheet approval). Off by default.</description></field>
    </extend-entity>

    <entity entity-name="AccountingCloseRun" package="mantle.ledger.transaction" cache="never">
        <description>One close of an organization's fiscal period (CloseServices.close#Period): who closed it, why, the
            checklist it passed, the closing transactions it posted and the totals of the summary rows it stored. A
            reopen (reopen#Period) marks the run reopened with its reason and keeps it; the next close is a new run.</description>
        <field name="closeRunId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="timePeriodId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="closedByUserId" type="id"/>
        <field name="closedDate" type="date-time"/>
        <field name="closeReason" type="text-medium"/>
        <field name="operationKey" type="text-short"/>
        <field name="checklistJson" type="text-very-long"><description>The checklist rows at close</description></field>
        <field name="closingAcctgTransIds" type="text-long">
            <description>The closing transactions, comma separated</description></field>
        <field name="netIncomeGlAccountId" type="id"/>
        <field name="summaryAccountCount" type="number-integer"/>
        <field name="summaryDebitTotal" type="currency-amount"/>
        <field name="summaryCreditTotal" type="currency-amount"/>
        <field name="reopenedByUserId" type="id" enable-audit-log="true"/>
        <field name="reopenedDate" type="date-time" enable-audit-log="true"/>
        <field name="reopenReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.party.time.TimePeriod"/>
        <relationship type="one" title="AccountingCloseRun" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one-nofk" title="NetIncome" related="mantle.ledger.account.GlAccount">
            <key-map field-name="netIncomeGlAccountId" related="glAccountId"/></relationship>
        <index name="ACCTG_CLOSE_RUN_PERIOD"><index-field name="timePeriodId"/></index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="AccountingCloseRun" description="Period close"/>
            <moqui.basic.StatusItem statusId="CrnClosed" description="Closed" sequenceNum="1"
                    statusTypeId="AccountingCloseRun"/>
            <moqui.basic.StatusItem statusId="CrnReopened" description="Reopened" sequenceNum="2"
                    statusTypeId="AccountingCloseRun"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="CrnClosed" toStatusId="CrnReopened"
                    transitionName="Reopen"/>
        </seed-data>
    </entity>

    <entity entity-name="AccountingPeriodRun" package="mantle.ledger.transaction" cache="never">
        <description>A period calculation of one kind (PeriodRunKind: depreciation, project cost and later kinds) for an
            organization and period: previewed by PeriodRunServices.preview#Run, which stores its results and the
            version of its calculation, then posted by its kind's post service. Recalculating supersedes the earlier
            preview of the same kind, organization and period. A failed source is a failed result; the others stand.</description>
        <field name="periodRunId" type="id" is-pk="true"/>
        <field name="runKindEnumId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="timePeriodId" type="id"/>
        <field name="effectiveDate" type="date"><description>The book day of the postings</description></field>
        <field name="currencyUomId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="calculationVersion" type="text-long"><description>A hash of the results; posting takes it and
            refuses a run whose results changed</description></field>
        <field name="sourceSelectionJson" type="text-long">
            <description>The sources the user chose, when not all</description></field>
        <field name="totalAmount" type="currency-amount"/>
        <field name="resultCount" type="number-integer"/>
        <field name="failedCount" type="number-integer"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="postedByUserId" type="id" enable-audit-log="true"/>
        <field name="postedDate" type="date-time" enable-audit-log="true"/>
        <field name="supersededByRunId" type="id"/>
        <field name="reversedByRunId" type="id"/>
        <field name="reverseOfRunId" type="id"/>
        <relationship type="one" title="PeriodRunKind" related="moqui.basic.Enumeration" short-alias="kind">
            <key-map field-name="runKindEnumId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.party.time.TimePeriod"/>
        <relationship type="one" title="AccountingPeriodRun" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="many" related="mantle.ledger.transaction.AccountingPeriodRunResult" short-alias="results">
            <key-map field-name="periodRunId"/></relationship>
        <index name="ACCTG_PERIOD_RUN_ORG"><index-field name="organizationPartyId"/><index-field name="timePeriodId"/></index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="AccountingPeriodRun" description="Period run"/>
            <moqui.basic.StatusItem statusId="PrnPreview" description="Preview" sequenceNum="1"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusItem statusId="PrnPosted" description="Posted" sequenceNum="2"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusItem statusId="PrnPartial" description="Posted with failures" sequenceNum="3"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusItem statusId="PrnFailed" description="Failed" sequenceNum="4"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusItem statusId="PrnSuperseded" description="Recalculated" sequenceNum="5"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusItem statusId="PrnReversed" description="Reversed" sequenceNum="6"
                    statusTypeId="AccountingPeriodRun"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrnPreview" toStatusId="PrnPosted"
                    transitionName="Post"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrnPreview" toStatusId="PrnPartial"
                    transitionName="Post with failures"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrnPreview" toStatusId="PrnFailed"
                    transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrnPreview" toStatusId="PrnSuperseded"
                    transitionName="Recalculate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrnPosted" toStatusId="PrnReversed"
                    transitionName="Reverse"/>
        </seed-data>
    </entity>
    <entity entity-name="AccountingPeriodRunResult" package="mantle.ledger.transaction" cache="never">
        <description>One source of a period run (an asset, a time entry): its amount and accounts, or why it failed, and
            the transaction that posted it and any that reversed it.</description>
        <field name="periodRunId" type="id" is-pk="true"/>
        <field name="resultSeqId" type="id" is-pk="true"/>
        <field name="sourceEntityName" type="text-medium"/>
        <field name="sourceId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="amount" type="currency-amount"/>
        <field name="debitGlAccountId" type="id"/>
        <field name="creditGlAccountId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="failureCode" type="text-short"/>
        <field name="failureMessage" type="text-long"/>
        <field name="acctgTransId" type="id"/>
        <field name="reversalAcctgTransId" type="id"/>
        <relationship type="one" related="mantle.ledger.transaction.AccountingPeriodRun"/>
        <relationship type="one" title="AccountingPeriodRunResult" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one-nofk" related="mantle.ledger.transaction.AcctgTrans"/>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="AccountingPeriodRunResult" description="Period run result"/>
            <moqui.basic.StatusItem statusId="PrrReady" description="Ready" sequenceNum="1"
                    statusTypeId="AccountingPeriodRunResult"/>
            <moqui.basic.StatusItem statusId="PrrFailed" description="Failed" sequenceNum="2"
                    statusTypeId="AccountingPeriodRunResult"/>
            <moqui.basic.StatusItem statusId="PrrPosted" description="Posted" sequenceNum="3"
                    statusTypeId="AccountingPeriodRunResult"/>
            <moqui.basic.StatusItem statusId="PrrReversed" description="Reversed" sequenceNum="4"
                    statusTypeId="AccountingPeriodRunResult"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrrReady" toStatusId="PrrPosted"
                    transitionName="Post"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrrReady" toStatusId="PrrFailed"
                    transitionName="Fail"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrrPosted" toStatusId="PrrReversed"
                    transitionName="Reverse"/>
        </seed-data>
    </entity>
</entities>
