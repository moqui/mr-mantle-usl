<!-- Bank statements and their reconciliation (mantle.account.ReconciliationServices): the statement imports, the
    statement sessions over the bank lines (PaymentMethodTrans), the match rules and the deposits of receipts. The bank
    lines stay the one record of what the bank reported; a session links them, it does not copy them. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="StatementImport" package="mantle.account.method" cache="never">
        <description>One statement file read for a bank account: review#StatementImport parses it and classifies each row as
            new, a duplicate of a line already imported (by its identity, the bank's FIT id or the source-row key) or
            rejected, and commit#StatementImport creates the new lines. The rows are kept as the user reviewed them, with
            what commit did to each.</description>
        <field name="statementImportId" type="id" is-pk="true"/>
        <field name="paymentMethodId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="formatEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="fileName" type="text-medium"/>
        <field name="currencyUomId" type="id"/>
        <field name="statementFromDate" type="date"/>
        <field name="statementThruDate" type="date"/>
        <field name="ledgerBalance" type="currency-amount"/>
        <field name="availableBalance" type="currency-amount"/>
        <field name="balanceDate" type="date-time"/>
        <field name="totalCount" type="number-integer"/>
        <field name="newCount" type="number-integer"/>
        <field name="duplicateCount" type="number-integer"/>
        <field name="rejectedCount" type="number-integer"/>
        <field name="committedCount" type="number-integer"/>
        <field name="warningsJson" type="text-long"><description>File-level warnings, such as a BAI2 control total that
            does not match the rows read</description></field>
        <field name="rowsJson" type="text-very-long"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="committedByUserId" type="id"/>
        <field name="committedDate" type="date-time"/>
        <relationship type="one" related="mantle.account.method.PaymentMethod" short-alias="paymentMethod"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="StatementImportFormat" related="moqui.basic.Enumeration" short-alias="format">
            <key-map field-name="formatEnumId"/></relationship>
        <relationship type="one" title="StatementImport" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one" title="Currency" related="moqui.basic.Uom" short-alias="currency">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <index name="STATEMENT_IMPORT_BANK"><index-field name="paymentMethodId"/><index-field name="createdDate"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Statement Import Format" enumTypeId="StatementImportFormat"/>
            <moqui.basic.Enumeration enumId="SifBai2" enumCode="BAI2" description="BAI2" sequenceNum="1"
                    enumTypeId="StatementImportFormat"/>
            <moqui.basic.Enumeration enumId="SifOfx" enumCode="OFX" description="OFX or QFX" sequenceNum="2"
                    enumTypeId="StatementImportFormat"/>
            <moqui.basic.Enumeration enumId="SifCsv" enumCode="CSV" description="CSV" sequenceNum="3"
                    enumTypeId="StatementImportFormat"/>
            <moqui.basic.StatusType description="Statement Import" statusTypeId="StatementImport"/>
            <moqui.basic.StatusItem statusId="SimReview" description="In review" sequenceNum="1"
                    statusTypeId="StatementImport"/>
            <moqui.basic.StatusItem statusId="SimCommitted" description="Imported" sequenceNum="3"
                    statusTypeId="StatementImport"/>
            <moqui.basic.StatusItem statusId="SimCommitting" description="Importing" sequenceNum="2"
                    statusTypeId="StatementImport"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SimReview" toStatusId="SimCommitting"
                    transitionName="Start import"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SimCommitting" toStatusId="SimCommitted"
                    transitionName="Import"/>
        </seed-data>
    </entity>
    <extend-entity entity-name="PaymentMethodTrans" package="mantle.account.method">
        <field name="statementImportId" type="id"><description>The statement import that created the line</description>
        </field>
        <field name="paymentDepositId" type="id"><description>The deposit this one bank line reconciles, all its receipts at
            once</description></field>
        <field name="noReconcileReason" type="text-medium" enable-audit-log="update"><description>Why the line is not
            reconciled (noReconcile Y): a statement session clears an excluded line only with its reason</description>
        </field>
        <relationship type="one" related="mantle.account.method.StatementImport" short-alias="statementImport"/>
        <relationship type="one" related="mantle.account.payment.PaymentDeposit" short-alias="deposit"/>
        <index name="PMT_METHOD_TRANS_DEPOSIT"><index-field name="paymentDepositId"/></index>
        <index name="PMT_METHOD_TRANS_POSTED"><index-field name="paymentMethodId"/><index-field name="postedDate"/></index>
    </extend-entity>

    <entity entity-name="BankReconciliation" package="mantle.account.method" cache="never" optimistic-lock="true">
        <description>A bank statement session: one statement of one bank account for its period, with the statement's
            opening and closing balances. The lines it clears are BankReconciliationLine rows over the bank lines of the
            period; finish#Reconciliation completes it only when every line of the period is cleared and the opening
            balance and the cleared lines add up to the closing balance. Sessions of one bank never overlap.</description>
        <field name="bankReconciliationId" type="id" is-pk="true"/>
        <field name="paymentMethodId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="statementReference" type="text-medium" enable-audit-log="update"/>
        <field name="statementFromDate" type="date" enable-audit-log="update"/>
        <field name="statementThruDate" type="date" enable-audit-log="update"/>
        <field name="currencyUomId" type="id"/>
        <field name="openingBalance" type="currency-amount" enable-audit-log="update"/>
        <field name="closingBalance" type="currency-amount" enable-audit-log="update"/>
        <field name="clearedInflow" type="currency-amount"><description>At finish: the positive cleared lines</description>
        </field>
        <field name="clearedOutflow" type="currency-amount"><description>At finish: the negative cleared lines, as a
            positive amount</description></field>
        <field name="clearedCount" type="number-integer"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="finishedByUserId" type="id" enable-audit-log="true"/>
        <field name="finishedDate" type="date-time" enable-audit-log="true"/>
        <relationship type="one" related="mantle.account.method.PaymentMethod" short-alias="paymentMethod"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="BankReconciliation" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one" title="Currency" related="moqui.basic.Uom" short-alias="currency">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <relationship type="many" related="mantle.account.method.BankReconciliationLine" short-alias="lines">
            <key-map field-name="bankReconciliationId"/></relationship>
        <index name="BANK_REC_BANK_PERIOD">
            <index-field name="paymentMethodId"/><index-field name="statementFromDate"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Bank Reconciliation" statusTypeId="BankReconciliation"/>
            <moqui.basic.StatusItem statusId="BrecDraft" description="In progress" sequenceNum="1"
                    statusTypeId="BankReconciliation"/>
            <moqui.basic.StatusItem statusId="BrecFinished" description="Finished" sequenceNum="2"
                    statusTypeId="BankReconciliation"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="BrecDraft" toStatusId="BrecFinished"
                    transitionName="Finish"/>
        </seed-data>
    </entity>
    <entity entity-name="BankReconciliationLine" package="mantle.account.method" cache="never">
        <description>A bank line a statement session cleared. The key is the bank line, so one line is cleared by one
            session only: a second session's clear is refused by the key, however the two requests interleave.</description>
        <field name="paymentMethodId" type="id" is-pk="true"/>
        <field name="fitId" type="text-short" is-pk="true"/>
        <field name="bankReconciliationId" type="id"/>
        <field name="clearedByUserId" type="id"/>
        <field name="clearedDate" type="date-time"/>
        <relationship type="one" related="mantle.account.method.BankReconciliation" short-alias="reconciliation"/>
        <relationship type="one" related="mantle.account.method.PaymentMethodTrans" short-alias="trans"/>
        <index name="BANK_REC_LINE_REC"><index-field name="bankReconciliationId"/></index>
    </entity>
    <view-entity entity-name="BankReconciliationCleared" package="mantle.account.method" cache="never">
        <description>The cleared total and count of each statement session.</description>
        <member-entity entity-alias="L" entity-name="mantle.account.method.BankReconciliationLine"/>
        <member-entity entity-alias="T" entity-name="mantle.account.method.PaymentMethodTrans" join-from-alias="L">
            <key-map field-name="paymentMethodId"/><key-map field-name="fitId"/></member-entity>
        <alias entity-alias="L" name="bankReconciliationId"/>
        <alias entity-alias="T" name="clearedTotal" field="transAmount" function="sum"/>
        <alias entity-alias="L" name="clearedCount" field="fitId" function="count"/>
    </view-entity>

    <entity entity-name="BankMatchRule" package="mantle.account.method" cache="never">
        <description>A rule that suggests the counterparty of a bank line from its text: a line whose name, memo or
            reference contains the match text, in the rule's direction and amount range, is suggested the payments of the
            rule's party for the same amount. A rule with autoApply reconciles a line only when it is the one rule
            matching the line and finds exactly one payment; otherwise it only suggests. An ended rule (thruDate) stays for
            the audit.</description>
        <field name="bankMatchRuleId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentMethodId" type="id" enable-audit-log="update"><description>Only lines of this bank account;
            empty for every bank account of the organization</description></field>
        <field name="description" type="text-medium" enable-audit-log="update"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="update"><description>The priority: a lower number
            first</description></field>
        <field name="matchText" type="text-medium" enable-audit-log="update"/>
        <field name="directionEnumId" type="id" enable-audit-log="update"/>
        <field name="amountFrom" type="currency-amount" enable-audit-log="update"/>
        <field name="amountThru" type="currency-amount" enable-audit-log="update"/>
        <field name="partyId" type="id" enable-audit-log="update"/>
        <field name="autoApply" type="text-indicator" enable-audit-log="update"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.account.method.PaymentMethod" short-alias="paymentMethod"/>
        <relationship type="one" title="BankMatchDirection" related="moqui.basic.Enumeration" short-alias="direction">
            <key-map field-name="directionEnumId"/></relationship>
        <relationship type="one" title="Suggested" related="mantle.party.Party" short-alias="party">
            <key-map field-name="partyId"/></relationship>
        <index name="BANK_MATCH_RULE_ORG"><index-field name="organizationPartyId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Bank Match Direction" enumTypeId="BankMatchDirection"/>
            <moqui.basic.Enumeration enumId="BmdIncoming" description="Money in" sequenceNum="1"
                    enumTypeId="BankMatchDirection"/>
            <moqui.basic.Enumeration enumId="BmdOutgoing" description="Money out" sequenceNum="2"
                    enumTypeId="BankMatchDirection"/>
        </seed-data>
    </entity>

    <entity entity-name="PaymentDeposit" package="mantle.account.payment" cache="never">
        <description>A deposit slip: receipts of one bank account and currency taken to the bank together, so the bank
            reports one line for them. Each receipt points at its deposit (Payment.paymentDepositId), and the deposit's one
            bank line reconciles them all (PaymentMethodTrans.paymentDepositId).</description>
        <field name="paymentDepositId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentMethodId" type="id"><description>The bank account the receipts are deposited in</description>
        </field>
        <field name="depositDate" type="date-time"/>
        <field name="referenceNumber" type="text-medium"/>
        <field name="totalAmount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="paymentCount" type="number-integer"/>
        <field name="operationKey" type="id"/>
        <field name="requestHash" type="text-long"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.account.method.PaymentMethod" short-alias="paymentMethod"/>
        <relationship type="one" title="Currency" related="moqui.basic.Uom" short-alias="currency">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <relationship type="many" related="mantle.account.payment.Payment" short-alias="payments">
            <key-map field-name="paymentDepositId"/></relationship>
        <index name="PAYMENT_DEPOSIT_BANK"><index-field name="paymentMethodId"/><index-field name="depositDate"/></index>
        <index name="PAYMENT_DEPOSIT_KEY" unique="true"><index-field name="operationKey"/></index>
    </entity>
    <extend-entity entity-name="Payment" package="mantle.account.payment">
        <field name="paymentDepositId" type="id" enable-audit-log="update"><description>The deposit slip this receipt was
            deposited with (create#DepositSlip)</description></field>
        <relationship type="one" related="mantle.account.payment.PaymentDeposit" short-alias="deposit"/>
        <index name="PAYMENT_DEPOSIT"><index-field name="paymentDepositId"/></index>
    </extend-entity>
</entities>
