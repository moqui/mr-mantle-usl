<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="PartyAcctgPreference" package="mantle.ledger.config">
        <field name="singleCurrencyDocumentsOnly" type="text-indicator" default="'N'" enable-audit-log="update"/>
        <field name="invoiceApprovalRequired" type="text-indicator" default="'N'" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="PostingOperation" package="mantle.ledger.transaction">
        <field name="resultJson" type="text-very-long"/>
    </extend-entity>
    <extend-entity entity-name="AcctgTrans" package="mantle.ledger.transaction">
        <field name="accountingDate" type="date" enable-audit-log="true"/>
        <index name="ACCTG_TRANS_ORG_BOOK_DATE">
            <index-field name="organizationPartyId"/>
            <index-field name="accountingDate"/>
        </index>
    </extend-entity>
    <extend-entity entity-name="Invoice" package="mantle.account.invoice">
        <field name="accountingDate" type="date" enable-audit-log="update"/>
        <field name="draftedByUserId" type="id" enable-audit-log="update"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedSourceVersion" type="text-long" enable-audit-log="true"/>
        <field name="isSelfApproved" type="text-indicator" enable-audit-log="true"/>
        <field name="creditForInvoiceId" type="id" enable-audit-log="true"/>
        <field name="workflowSourceKey" type="text-medium" enable-audit-log="true"/>
        <field name="financeOrganizationPartyId" type="id" enable-audit-log="true"/>
        <field name="financeDirection" type="text-short" enable-audit-log="true"/>
        <relationship type="one" title="CreditFor" related="mantle.account.invoice.Invoice">
            <key-map field-name="creditForInvoiceId" related="invoiceId"/>
        </relationship>
        <index name="INVOICE_WORKFLOW_SOURCE"><index-field name="workflowSourceKey"/></index>
    </extend-entity>
    <extend-entity entity-name="InvoiceContent" package="mantle.account.invoice">
        <field name="isImmutable" type="text-indicator" default="'N'">
            <description>Y for an issued file: the PDF send#Invoice froze and each supporting copy it sent.</description></field>
    </extend-entity>
    <view-entity entity-name="InvoiceFinance" package="mantle.account.invoice" cache="never">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="SRC" entity-name="mantle.account.invoice.Invoice" join-from-alias="INV" join-optional="true">
            <key-map field-name="creditForInvoiceId" related="invoiceId"/>
        </member-entity>
        <member-entity entity-alias="FROMP" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="fromPartyId" related="partyId"/>
        </member-entity>
        <member-entity entity-alias="TOP" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="toPartyId" related="partyId"/>
        </member-entity>
        <alias-all entity-alias="INV"/>
        <alias entity-alias="SRC" name="sourceFromPartyId" field="fromPartyId"/>
        <alias entity-alias="SRC" name="sourceToPartyId" field="toPartyId"/>
        <alias entity-alias="FROMP" name="fromPrivateOwnerUserId" field="privateOwnerUserId"/>
        <alias entity-alias="FROMP" name="fromPartyTypeEnumId" field="partyTypeEnumId"/>
        <alias entity-alias="TOP" name="toPrivateOwnerUserId" field="privateOwnerUserId"/>
    </view-entity>
    <extend-entity entity-name="PartyIdentification" package="mantle.party">
        <field name="idValue" type="text-medium" encrypt="true" enable-audit-log="update"/>
        <field name="issuedBy" type="text-medium" enable-audit-log="update"/>
        <field name="expireDate" type="date" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="TaxAuthorityParty" package="mantle.other.tax">
        <field name="partyTaxId" type="text-short" enable-audit-log="true"/>
        <field name="isExempt" type="text-indicator" enable-audit-log="true"/>
        <field name="isNexus" type="text-indicator" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
    </extend-entity>
</entities>
