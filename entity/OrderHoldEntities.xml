<!-- Order holds by reason (design-crosscut §3.6, CX-ORDER-HOLD): an order on OrderHold names why, so one app's hold is
    never released by another app's decision (mantle.order.OrderServices.hold#Order, release#OrderHold). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="OrderHoldReason" package="mantle.order" cache="never">
        <description>Why an order (or one of its parts) is on hold: a credit, change, purchase or manual reason, the record that
            caused it (sourceId: a credit check, a change request, a revision), who placed it and when, and who released it,
            when and why. The order is on OrderHold while any reason is open; release#OrderHold releases one reason and moves
            the order back (to returnStatusId, Approved by default) only when no other reason is open.</description>
        <field name="orderHoldReasonId" type="id" is-pk="true"/>
        <field name="orderId" type="id"/>
        <field name="orderPartSeqId" type="id"/>
        <field name="holdTypeEnumId" type="id"/>
        <field name="sourceId" type="id"/>
        <field name="holdComment" type="text-medium" enable-audit-log="true"/>
        <field name="returnStatusId" type="id"><description>The status the order returns to when its last reason is
            released.</description></field>
        <field name="placedByUserId" type="id"/>
        <field name="placedDate" type="date-time"/>
        <field name="releasedByUserId" type="id" enable-audit-log="true"/>
        <field name="releasedDate" type="date-time" enable-audit-log="true"/>
        <field name="releaseComment" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.order.OrderHeader"/>
        <relationship type="one" title="OrderHoldType" related="moqui.basic.Enumeration">
            <key-map field-name="holdTypeEnumId" related="enumId"/></relationship>
        <index name="ORDER_HOLD_REASON_ORDER"><index-field name="orderId"/><index-field name="releasedDate"/></index>
        <seed-data>
            <!-- enumCode: the permission that releases the reason -->
            <moqui.basic.EnumerationType description="Order Hold Type" enumTypeId="OrderHoldType"/>
            <moqui.basic.Enumeration enumId="OhtCredit" enumTypeId="OrderHoldType" sequenceNum="1" description="Credit"
                    enumCode="CREDIT_HOLD_RELEASE"/>
            <moqui.basic.Enumeration enumId="OhtChange" enumTypeId="OrderHoldType" sequenceNum="2" description="Change"
                    enumCode="ORDER_APPROVE"/>
            <moqui.basic.Enumeration enumId="OhtPurchase" enumTypeId="OrderHoldType" sequenceNum="3" description="Purchase"
                    enumCode="ORDER_APPROVE"/>
            <moqui.basic.Enumeration enumId="OhtManual" enumTypeId="OrderHoldType" sequenceNum="4" description="Manual"
                    enumCode="ORDER_APPROVE"/>
        </seed-data>
    </entity>
</entities>
