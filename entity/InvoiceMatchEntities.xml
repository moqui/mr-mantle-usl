<!-- Bill matching (mantle.account.InvoiceMatchServices): a bill's lines matched to purchase order lines and their accepted
    receipts, the match policy of an organization as effective-dated rows, and the matches a source change has made
    stale. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="InvoiceMatchPolicy" package="mantle.account.invoice" cache="never">
        <description>How an organization matches its suppliers' bills, as effective-dated rows: a change ends the row in
            effect and starts the next (store#MatchPolicy). A row for a product wins over one for a category of the
            product, which wins over the organization's row (no product and no category). A match line keeps the row it
            applied.</description>
        <field name="invoiceMatchPolicyId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="productCategoryId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="billBasisEnumId" type="id" enable-audit-log="true">
            <description>ImbReceived: a bill line matches the accepted quantity of the order line's receipts (three-way);
                ImbOrdered: the ordered quantity (two-way).</description></field>
        <field name="receiptRequired" type="text-indicator" enable-audit-log="true">
            <description>Y: on the ordered basis a line whose order line has no accepted receipt is a match
                exception.</description>
        </field>
        <field name="quantityTolerancePercent" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityToleranceQuantity" type="number-decimal" enable-audit-log="true"/>
        <field name="priceTolerancePercent" type="number-decimal" enable-audit-log="true"/>
        <field name="priceToleranceAmount" type="currency-precise" enable-audit-log="true"/>
        <field name="varianceActionEnumId" type="id" enable-audit-log="true">
            <description>ImaHold: a variance outside tolerance holds the bill (IhrMatchException); ImaWarn: it is named and
                the bill is not held.</description></field>
        <field name="selfBillingDefault" type="text-indicator" enable-audit-log="true">
            <description>Y: a supplier's first profile row takes self-billing unless the change says otherwise
                (store#SupplierProfile).</description></field>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="mantle.product.category.ProductCategory"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" title="InvoiceMatchBasis" related="moqui.basic.Enumeration">
            <key-map field-name="billBasisEnumId" related="enumId"/>
        </relationship>
        <relationship type="one" title="InvoiceMatchAction" related="moqui.basic.Enumeration">
            <key-map field-name="varianceActionEnumId" related="enumId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Invoice Match Basis" enumTypeId="InvoiceMatchBasis"/>
            <moqui.basic.Enumeration description="Accepted receipts (three-way)" enumId="ImbReceived"
                    enumTypeId="InvoiceMatchBasis" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Ordered quantity (two-way)" enumId="ImbOrdered"
                    enumTypeId="InvoiceMatchBasis" sequenceNum="2"/>
            <moqui.basic.EnumerationType description="Invoice Match Variance Action" enumTypeId="InvoiceMatchAction"/>
            <moqui.basic.Enumeration description="Hold the bill" enumId="ImaHold" enumTypeId="InvoiceMatchAction"
                    sequenceNum="1"/>
            <moqui.basic.Enumeration description="Warn only" enumId="ImaWarn" enumTypeId="InvoiceMatchAction"
                    sequenceNum="2"/>
        </seed-data>
        <index name="INV_MATCH_POLICY_ORG"><index-field name="organizationPartyId"/><index-field name="fromDate"/></index>
    </entity>
    <entity entity-name="InvoiceMatch" package="mantle.account.invoice" cache="never">
        <description>A bill's applied match (apply#InvoiceMatch, apply#LegacyMatches): its lines are the allocations to
            order lines and receipts, written also as OrderItemBilling. Unapplying ends it (ImUnapplied) and reverses the
            billing links; a bill has at most one applied match. A source change marks it stale (staleDate, by
            queue#MatchReevaluation) until the re-evaluation job evaluates it again.</description>
        <field name="invoiceMatchId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="resultEnumId" type="id" enable-audit-log="true"/>
        <field name="resultText" type="text-long"/>
        <field name="isLegacy" type="text-indicator"><description>Y: linked by the legacy backfill from existing billing
            and receipt evidence.</description></field>
        <field name="appliedDate" type="date-time"/>
        <field name="appliedByUserId" type="id"/>
        <field name="evaluatedDate" type="date-time"/>
        <field name="staleDate" type="date-time"/>
        <field name="staleReason" type="text-medium"/>
        <field name="unappliedDate" type="date-time"/>
        <field name="unappliedByUserId" type="id"/>
        <field name="invoiceHoldId" type="id"><description>The match exception hold the match placed, if any.</description>
        </field>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" title="InvoiceMatch" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>
        <relationship type="one" title="InvoiceMatchResult" related="moqui.basic.Enumeration">
            <key-map field-name="resultEnumId" related="enumId"/>
        </relationship>
        <relationship type="many" related="mantle.account.invoice.InvoiceMatchLine">
            <key-map field-name="invoiceMatchId"/>
        </relationship>
        <seed-data>
            <moqui.basic.StatusType description="Invoice Match" statusTypeId="InvoiceMatch"/>
            <moqui.basic.StatusItem description="Applied" sequenceNum="1" statusId="ImApplied" statusTypeId="InvoiceMatch"/>
            <moqui.basic.StatusItem description="Unapplied" sequenceNum="2" statusId="ImUnapplied" statusTypeId="InvoiceMatch"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="ImApplied" toStatusId="ImUnapplied"
                    transitionName="Unapply"/>
            <moqui.basic.EnumerationType description="Invoice Match Result" enumTypeId="InvoiceMatchResult"/>
            <moqui.basic.Enumeration description="Matched" enumId="ImrMatched" enumTypeId="InvoiceMatchResult" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Partly matched" enumId="ImrPartial" enumTypeId="InvoiceMatchResult"
                    sequenceNum="2"/>
            <moqui.basic.Enumeration description="Exception" enumId="ImrException" enumTypeId="InvoiceMatchResult"
                    sequenceNum="3"/>
        </seed-data>
        <index name="INV_MATCH_INVOICE"><index-field name="invoiceId"/><index-field name="statusId"/></index>
        <index name="INV_MATCH_STALE"><index-field name="staleDate"/></index>
    </entity>
    <entity entity-name="InvoiceMatchLine" package="mantle.account.invoice" cache="never">
        <description>One line of a match: a bill line's quantity allocated to an order line, and to one of its receipts on
            the received basis, with the snapshot it was checked against (ordered, accepted, held and earlier billed
            quantity, the prices), the policy row applied and the line's exception; or a bill line with no source, named
            as an exception. orderItemBillingId is the billing link it wrote or updated; previousQuantity the link's
            quantity before (null when the match created it), which unapply restores.</description>
        <field name="invoiceMatchId" type="id" is-pk="true"/>
        <field name="invoiceMatchLineSeqId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceItemSeqId" type="id"/>
        <field name="orderId" type="id"/>
        <field name="orderItemSeqId" type="id"/>
        <field name="assetReceiptId" type="id"/>
        <field name="shipmentId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="invoiceQuantity" type="number-decimal"/>
        <field name="invoiceUnitAmount" type="currency-precise"/>
        <field name="orderQuantity" type="number-decimal"/>
        <field name="orderUnitAmount" type="currency-precise"/>
        <field name="acceptedQuantity" type="number-decimal"/>
        <field name="heldQuantity" type="number-decimal"><description>Accepted quantity still in quarantine, left out of
            the match. There is no inspection record yet (CX-QUALITY), so the inspection check itself is
            unavailable.</description></field>
        <field name="priorBilledQuantity" type="number-decimal"/>
        <field name="priceVariance" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="billBasisEnumId" type="id"/>
        <field name="invoiceMatchPolicyId" type="id"/>
        <field name="exceptionEnumId" type="id"/>
        <field name="exceptionText" type="text-medium"/>
        <field name="orderItemBillingId" type="id"/>
        <field name="previousQuantity" type="number-decimal"/>
        <field name="receiptLinked" type="text-indicator"><description>Y: the match set the receipt's invoice, which unapply
            clears.</description></field>
        <relationship type="one" related="mantle.account.invoice.InvoiceMatch"/>
        <relationship type="one" related="mantle.account.invoice.InvoiceItem"/>
        <relationship type="one" related="mantle.order.OrderItem"/>
        <relationship type="one" related="mantle.product.receipt.AssetReceipt"/>
        <relationship type="one" related="mantle.account.invoice.InvoiceMatchPolicy"/>
        <relationship type="one" title="InvoiceMatchException" related="moqui.basic.Enumeration">
            <key-map field-name="exceptionEnumId" related="enumId"/>
        </relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Invoice Match Exception" enumTypeId="InvoiceMatchException"/>
            <moqui.basic.Enumeration description="Quantity variance" enumId="MeQuantityVariance"
                    enumTypeId="InvoiceMatchException" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Price variance" enumId="MePriceVariance" enumTypeId="InvoiceMatchException"
                    sequenceNum="2"/>
            <moqui.basic.Enumeration description="Missing receipt" enumId="MeMissingReceipt"
                    enumTypeId="InvoiceMatchException" sequenceNum="3"/>
            <moqui.basic.Enumeration description="Inspection hold" enumId="MeInspectionHold"
                    enumTypeId="InvoiceMatchException" sequenceNum="4"/>
            <moqui.basic.Enumeration description="Source changed" enumId="MeSourceChanged"
                    enumTypeId="InvoiceMatchException" sequenceNum="5"/>
            <moqui.basic.Enumeration description="No order source" enumId="MeNoSource" enumTypeId="InvoiceMatchException"
                    sequenceNum="6"/>
            <moqui.basic.Enumeration description="Ambiguous evidence" enumId="MeAmbiguous"
                    enumTypeId="InvoiceMatchException" sequenceNum="7"/>
        </seed-data>
        <index name="INV_MATCH_LN_RECEIPT"><index-field name="assetReceiptId"/></index>
        <index name="INV_MATCH_LN_ORDER"><index-field name="orderId"/><index-field name="orderItemSeqId"/></index>
    </entity>
</entities>
