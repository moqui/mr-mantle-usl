<#-- An approved budget as of one revision, printed to PDF and stored as its content by mantle.other.BudgetServices
     (change#BudgetState approve, revise#Budget): budgetId, description, organizationName, periodName, revisionText,
     revisionReason, revisedText, revisedBy, totalText and lines (account, period, amount). -->
<!doctype html>
<html><head><meta charset="utf-8"><title>${ec.l10n.localize('Budget')} ${budgetId}</title>
<style>
@page { size: A4; margin: 18mm; }
body { font: 10pt Helvetica, Arial, sans-serif; color: #20252b; }
h1 { font-size: 18pt; margin: 0 0 6mm; }
table { border-collapse: collapse; width: 100%; }
td, th { padding: 4px 6px; text-align: left; vertical-align: top; }
thead { display: table-header-group; }
tbody tr { break-inside: avoid; }
.facts th { width: 35mm; font-weight: bold; }
.lines { margin-top: 6mm; }
.lines th { border-bottom: 1px solid #20252b; }
.lines td { border-bottom: 1px solid #ddd; }
.amount { text-align: right; white-space: nowrap; }
.total td { border-bottom: none; font-weight: bold; }
</style></head>
<body>
<h1>${description}</h1>
<table class="facts"><tbody>
    <tr><th>${ec.l10n.localize('Budget')}</th><td>${budgetId}</td></tr>
    <tr><th>${ec.l10n.localize('Organization')}</th><td>${organizationName}</td></tr>
    <tr><th>${ec.l10n.localize('Period')}</th><td>${periodName}</td></tr>
    <tr><th>${ec.l10n.localize('Revision')}</th><td>${revisionText}, ${revisedText} ${ec.l10n.localize('by')} ${revisedBy}</td></tr>
    <#if revisionReason><tr><th>${ec.l10n.localize('Reason')}</th><td>${revisionReason}</td></tr></#if>
</tbody></table>
<table class="lines">
    <thead><tr>
        <th>${ec.l10n.localize('Account')}</th>
        <th>${ec.l10n.localize('Period')}</th>
        <th class="amount">${ec.l10n.localize('Amount')}</th>
    </tr></thead>
    <tbody>
    <#list lines as line>
        <tr>
            <td>${line.account}</td>
            <td>${line.period}</td>
            <td class="amount">${line.amount}</td>
        </tr>
    </#list>
        <tr class="total">
            <td></td>
            <td class="amount">${ec.l10n.localize('Total')}</td>
            <td class="amount">${totalText}</td>
        </tr>
    </tbody>
</table>
</body></html>
