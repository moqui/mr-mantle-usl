<#-- A payment reminder of mantle.account.CollectionServices.send#Dunning: notice (its customer name, level, currency and
     overdue invoices with their reference, due day, days overdue and unpaid amount), organizationName and asOfDateText. -->
<#assign money = (value) => ec.l10n.formatCurrency(toDecimal(value ?? 0), notice.currencyUomId)>
<!doctype html>
<html><head><meta charset="utf-8"><title>${ec.l10n.localize('Payment reminder')}</title>
<style>
body { font: 10pt Helvetica, Arial, sans-serif; color: #20252b; }
table { border-collapse: collapse; width: 100%; }
td, th { padding: 4px 6px; text-align: left; border-bottom: 1px solid #ddd; }
th { border-bottom: 1px solid #20252b; }
.amount { text-align: right; white-space: nowrap; }
.total td { font-weight: bold; border-bottom: none; }
</style></head>
<body>
<p>${notice.customerName},</p>
<p>${notice.levelText}</p>
<p>${ec.l10n.localize('These invoices from')} <strong>${organizationName}</strong> ${ec.l10n.localize('are past due as of')}
    ${asOfDateText}:</p>
<table>
    <thead><tr>
        <th>${ec.l10n.localize('Invoice')}</th><th>${ec.l10n.localize('Reference')}</th><th>${ec.l10n.localize('Due')}</th>
        <th class="amount">${ec.l10n.localize('Days overdue')}</th><th class="amount">${ec.l10n.localize('Unpaid')}</th>
    </tr></thead>
    <tbody>
    <#list notice.invoiceRows as invoice>
        <tr><td>${invoice.invoiceId}</td><td>${invoice.referenceNumber ?? ''}</td><td>${invoice.dueDateText}</td>
            <td class="amount">${invoice.daysOverdue}</td><td class="amount">${money(invoice.unpaidTotal)}</td></tr>
    </#list>
    <tr class="total"><td colspan="4">${ec.l10n.localize('Total past due')}</td>
        <td class="amount">${money(notice.overdueAmount)}</td></tr>
    </tbody>
</table>
<p>${ec.l10n.localize('If you have already paid, thank you, and please disregard this reminder.')}</p>
</body></html>
