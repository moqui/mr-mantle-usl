<#-- The body of an invoice email (mantle.account.InvoiceServices.send#Invoice): the sender's note, the pay link when the
     organization has a Billing site, then the invoice as printed by get#InvoiceOutput, whose PDF is attached. -->
<#if note><div style="font:11pt Helvetica,Arial,sans-serif;margin-bottom:16px">
<#list String(note).split('\n') as noteLine>${noteLine}<br></#list>
</div></#if>
<#if payUrl><p style="font:11pt Helvetica,Arial,sans-serif;margin-bottom:16px"><a href="${payUrl}">View and pay this invoice online</a></p></#if>
${raw(printHtml)}
