<entity-facade-xml type="seed-initial">
    <!-- Payments started from a Billing page that are still pending: each is asked of its gateway every ten minutes, so a
        payer who never comes back still gets an answer (mantle.account.PortalServices.resolve#PortalPayments). -->
    <moqui.service.job.ServiceJob jobName="resolve_PortalPayments" description="Resolve pending Billing page payments"
            serviceName="mantle.account.PortalServices.resolve#PortalPayments" cronExpression="0 0/10 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
</entity-facade-xml>
