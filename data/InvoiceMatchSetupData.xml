<entity-facade-xml type="seed-initial">
    <!-- The bill match re-evaluation job: the matches a receipt or bill line change made stale, every five minutes; it
        names each bill's result and holds a bill whose match no longer holds up, and never releases a hold. -->
    <moqui.service.job.ServiceJob jobName="run_MatchReevaluation" description="Re-evaluate stale bill matches"
            serviceName="mantle.account.InvoiceMatchServices.run#MatchReevaluation" cronExpression="0 0/5 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
</entity-facade-xml>
