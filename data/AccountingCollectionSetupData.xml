<entity-facade-xml type="seed-initial">
    <!-- An order held for credit is released on the order (CreditServices.release#CreditHold), which marks these read -->
    <moqui.security.user.NotificationTopic topic="CreditHoldRelease" inboxEnumId="NinNotifications"
            description="Order held for credit" typeString="warning" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="Order ${orderId} of ${customerName} is held for credit"/>
    <!-- A recurring invoice that could not be made (RecurringInvoiceServices.generate#Occurrence) -->
    <moqui.security.user.NotificationTopic topic="RecurringInvoiceFailed" inboxEnumId="NinNotifications"
            description="Recurring invoice not made" typeString="danger" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Recurring invoice ${invoiceScheduleId} for ${occurrenceDate} was not made"/>

    <!-- Payment reminders (CollectionServices.send#Dunning): from the organization's billing address; the service passes
        subject, fromAddress and fromName in bodyParameters, and the body -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_DUNNING_EMAIL" description="Payment Reminder" emailServerId="SYSTEM"
            fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}"/>

    <!-- The recurring invoice schedules: the occurrences due, each its own draft, every night at 3:00 am -->
    <moqui.service.job.ServiceJob jobName="generate_RecurringInvoices" description="Make recurring invoices"
            serviceName="mantle.account.RecurringInvoiceServices.run#Schedules" cronExpression="0 0 3 * * ?" paused="N"
            transactionTimeout="1800"/>
</entity-facade-xml>
