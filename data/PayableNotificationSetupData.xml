<entity-facade-xml type="seed-initial">
    <!-- Sent to the topic's subscribers (NotificationTopicUser). A bill is approved or a hold released on the bill itself
        (approve#Payable, release#InvoiceHold), never from the notification, so these have no approve service. -->
    <moqui.security.user.NotificationTopic topic="BillApproval" inboxEnumId="NinNotifications" description="Bill to approve"
            typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Approve bill ${invoiceId}"/>
    <moqui.security.user.NotificationTopic topic="BillHoldRelease" inboxEnumId="NinNotifications"
            description="Bill hold release asked for" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="Release the hold on bill ${invoiceId}"/>
    <!-- A payment run is approved on the run (approve#Run), which marks these read -->
    <moqui.security.user.NotificationTopic topic="PaymentRunApproval" inboxEnumId="NinNotifications"
            description="Payment run to approve" typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="Approve payment run ${paymentRunId}"/>
</entity-facade-xml>
