<!-- Fixed asset books (mantle.ledger.AssetBookServices): the book event types, the transaction types of a book posting and
    depreciation as a kind of period run (PeriodRunServices). -->
<entity-facade-xml type="seed">
    <!-- the types are those of ProductCostData and AccountingCloseData, which may load after this file -->
    <moqui.basic.EnumerationType enumTypeId="AssetBookEventType" description="Asset book event type"/>
    <moqui.basic.EnumerationType enumTypeId="PeriodRunKind" description="Period run kind"/>
    <moqui.basic.Enumeration enumId="AbeCapitalize" enumTypeId="AssetBookEventType" description="Capitalized"/>
    <moqui.basic.Enumeration enumId="AbeAdjust" enumTypeId="AssetBookEventType" description="Book adjusted"/>
    <moqui.basic.Enumeration enumId="AbeDispose" enumTypeId="AssetBookEventType" description="Disposed"/>
    <moqui.basic.Enumeration enumId="AbeReversal" enumTypeId="AssetBookEventType" description="Reversed"/>
    <moqui.basic.Enumeration enumId="AbeCostRepair" enumTypeId="AssetBookEventType" description="Acquire cost repaired"/>

    <moqui.basic.Enumeration enumId="AttAssetBookAdjust" enumTypeId="AcctgTransType" description="Asset book adjustment"/>
    <moqui.basic.Enumeration enumId="AttAssetDisposal" enumTypeId="AcctgTransType" description="Asset disposal"/>

    <moqui.basic.Enumeration enumId="PrkDepreciation" enumTypeId="PeriodRunKind" sequenceNum="10" description="Depreciation"
            enumCode="mantle.ledger.AssetBookServices.calculate#DepreciationRun"
            optionValue="mantle.ledger.AssetBookServices.post#DepreciationRun"/>
</entity-facade-xml>
