<!-- Period close (mantle.ledger.CloseServices), period runs (PeriodRunServices) and project cost posting
    (OtherAutoPostServices.post#WorkEffortCost). -->
<entity-facade-xml type="seed">
    <!-- The rows of a period's close checklist, in order. Each names the service that finds its items (enumCode, a service
        implementing CloseServices.define#CloseCheck) and whether an item blocks the close (optionIndicator Y); another
        source adds its row with its own service. -->
    <moqui.basic.EnumerationType enumTypeId="PeriodCloseCheck" description="Period close check"/>
    <moqui.basic.Enumeration enumId="PccUnpostedTransactions" enumTypeId="PeriodCloseCheck" sequenceNum="10"
            description="Unposted transactions" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccErrorJournal" enumTypeId="PeriodCloseCheck" sequenceNum="20"
            description="Automatic postings in the error journal" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccImbalance" enumTypeId="PeriodCloseCheck" sequenceNum="30"
            description="Unbalanced transactions" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccUnpostedDocuments" enumTypeId="PeriodCloseCheck" sequenceNum="40"
            description="Unposted invoices, bills and payments" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccBankStatements" enumTypeId="PeriodCloseCheck" sequenceNum="50"
            description="Bank lines not on a finished statement" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccMissingRates" enumTypeId="PeriodCloseCheck" sequenceNum="60"
            description="Documents without an exchange rate" optionIndicator="Y"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccPayableHolds" enumTypeId="PeriodCloseCheck" sequenceNum="70"
            description="Bills on hold" optionIndicator="N"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccStockPostings" enumTypeId="PeriodCloseCheck" sequenceNum="80"
            description="Stock movements that posted nothing" optionIndicator="N"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccOpenWip" enumTypeId="PeriodCloseCheck" sequenceNum="90"
            description="Open WIP on completed assembly work" optionIndicator="N"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>
    <moqui.basic.Enumeration enumId="PccProjectCost" enumTypeId="PeriodCloseCheck" sequenceNum="100"
            description="Approved project time not posted to cost" optionIndicator="N"
            enumCode="mantle.ledger.CloseServices.check#StandardClose"/>

    <!-- The kinds of period run: enumCode the service that calculates a preview's results (implementing
        PeriodRunServices.define#RunCalculation), optionValue the service that posts a previewed run (implementing
        PeriodRunServices.define#RunPosting). -->
    <moqui.basic.EnumerationType enumTypeId="PeriodRunKind" description="Period run kind"/>
    <moqui.basic.Enumeration enumId="PrkProjectCost" enumTypeId="PeriodRunKind" sequenceNum="20"
            description="Project cost" enumCode="mantle.ledger.OtherAutoPostServices.calculate#WorkEffortCostRun"
            optionValue="mantle.ledger.OtherAutoPostServices.post#WorkEffortCostRun"/>

    <!-- Project cost: approved project time at its cost rate, debiting project cost and crediting labor clearing -->
    <moqui.basic.Enumeration enumId="AttWorkEffortCost" enumTypeId="AcctgTransType" description="Project cost"/>
    <moqui.basic.Enumeration enumId="GatProjectLaborCost" enumTypeId="GlAccountType" parentEnumId="GatCogs"
            description="Project labor cost"/>
    <moqui.basic.Enumeration enumId="GatLaborClearing" enumTypeId="GlAccountType"
            description="Labor clearing (wage expense absorbed by projects)"/>
</entity-facade-xml>
