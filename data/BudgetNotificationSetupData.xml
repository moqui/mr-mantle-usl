<entity-facade-xml type="seed-initial">
    <!-- Sent to the organization's users holding BUDGET_OVERRIDE when a budget control Stop refuses spending
        (mantle.other.BudgetServices; the blocked BudgetCommitment is its record). The override is given on the source
        document, with a reason, never from the notification. -->
    <moqui.security.user.NotificationTopic topic="BudgetOverride" inboxEnumId="NinNotifications"
            description="Spending over budget stopped" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="Over budget: ${sourceId} needs an override"/>
</entity-facade-xml>
