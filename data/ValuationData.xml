<!-- Inventory valuation and landed costs (AssetBookServices preview#/post#LandedCost, InventoryReportServices
    run#InventoryValuation), the production cost GL account types Manufacturing's cost close posts to, the scrap
    variance reasons, and the valuation rows of the period close checklist. -->
<entity-facade-xml type="seed">
    <!-- Landed costs: the basis a charge is spread by, and an allocation's state -->
    <moqui.basic.EnumerationType enumTypeId="LandedCostBasis" description="Landed cost allocation basis"/>
    <moqui.basic.Enumeration enumId="LcbQuantity" enumTypeId="LandedCostBasis" sequenceNum="10" description="Quantity"/>
    <moqui.basic.Enumeration enumId="LcbValue" enumTypeId="LandedCostBasis" sequenceNum="20" description="Value"/>
    <moqui.basic.Enumeration enumId="LcbWeight" enumTypeId="LandedCostBasis" sequenceNum="30" description="Weight"/>
    <moqui.basic.Enumeration enumId="LcbVolume" enumTypeId="LandedCostBasis" sequenceNum="40" description="Volume"/>
    <moqui.basic.StatusType statusTypeId="LandedCostAllocation" description="Landed cost allocation"/>
    <moqui.basic.StatusItem statusId="LcaPosted" statusTypeId="LandedCostAllocation" sequenceNum="10" description="Posted"/>
    <!-- the bill line types a landed cost allocates: freight, fees and other charges -->
    <moqui.basic.Enumeration enumId="EngItemsLandedCost" enumTypeId="EnumGroup" description="Landed cost charge items"/>
    <moqui.basic.EnumGroupMember enumId="ItemShipping" enumGroupEnumId="EngItemsLandedCost"/>
    <moqui.basic.EnumGroupMember enumId="ItemFee" enumGroupEnumId="EngItemsLandedCost"/>
    <moqui.basic.EnumGroupMember enumId="ItemMiscCharge" enumGroupEnumId="EngItemsLandedCost"/>
    <moqui.basic.Enumeration enumId="AttLandedCost" enumTypeId="AcctgTransType" description="Landed cost allocation"/>
    <moqui.basic.Enumeration enumId="AbeLandedCost" enumTypeId="AssetBookEventType" description="Landed cost"/>
    <moqui.basic.Enumeration enumId="AbeCostDataRepair" enumTypeId="AssetBookEventType" description="Cost data repair"/>

    <!-- Production cost close (Manufacturing): applied labor and overhead and accrued outside processing credited
        against WIP, and the residual to production variance. Each organization maps them in PostingDefaults. -->
    <moqui.basic.Enumeration enumId="GatLaborApplied" enumTypeId="GlAccountType" description="Applied production labor"/>
    <moqui.basic.Enumeration enumId="GatOverheadApplied" enumTypeId="GlAccountType"
            description="Applied production machine and overhead"/>
    <moqui.basic.Enumeration enumId="GatOutsideProcessAccrued" enumTypeId="GlAccountType"
            description="Accrued outside processing"/>
    <moqui.basic.Enumeration enumId="GatProductionVariance" enumTypeId="GlAccountType" parentEnumId="GatCogs"
            description="Production variance"/>

    <!-- Scrap reasons (enumCode scrap): a count variance with one posts to the organization's account for the reason,
        else to the asset type's scrap account (post#PhysicalInventoryVariance) -->
    <moqui.basic.Enumeration enumId="InVrScrap" enumTypeId="InventoryVarianceReason" enumCode="scrap" description="Scrap"/>
    <moqui.basic.Enumeration enumId="InVrExpired" enumTypeId="InventoryVarianceReason" enumCode="scrap"
            description="Expired"/>

    <!-- The valuation rows of the period close checklist (CloseServices.define#CloseCheck), shown without blocking -->
    <moqui.basic.Enumeration enumId="PccReceiptCostBasis" enumTypeId="PeriodCloseCheck" sequenceNum="82"
            description="Receipts without a cost basis" optionIndicator="N"
            enumCode="mantle.product.InventoryReportServices.check#ValuationClose"/>
    <moqui.basic.Enumeration enumId="PccValuationTieOut" enumTypeId="PeriodCloseCheck" sequenceNum="84"
            description="Inventory valuation against the inventory accounts" optionIndicator="N"
            enumCode="mantle.product.InventoryReportServices.check#ValuationClose"/>
</entity-facade-xml>
