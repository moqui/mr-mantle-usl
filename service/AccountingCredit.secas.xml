<!-- The customer credit check on Mantle's automatic approval (design-accounting §1.4, OrderPlacedAutoApprove; F34):
    autoApprove#Order approves only when check#OrderPreApprove has no warning, so a Warn or Hold result stops it, and
    while approving a Hold result puts the order on a Credit hold. Without a credit policy nothing is added. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="OrderPreApproveCredit" service="mantle.order.OrderInfoServices.check#OrderPreApprove" when="post-service">
        <actions>
            <service-call name="mantle.account.CreditServices.evaluate#OrderCredit" out-map="creditOut" disable-authz="true"
                    in-map="{orderId:orderId, placeHold:approving == true}"/>
            <if condition="creditOut.warning">
                <set field="results.approveWarnings"
                        from="Array.from(results.approveWarnings ?? []).concat([creditOut.warning])"/>
            </if>
        </actions>
    </seca>
</secas>
