<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="ShipmentOutgoingPackedCreateInvoices" service="update#mantle.shipment.Shipment" when="post-service">
        <description>Create sales invoice on Outgoing Shipment Packed. For a shipping organization whose
            PartyAcctgPreference.salesInvoiceFinalizedAtShip is Y (D3) the invoice stays in process with no payment
            applied; ShipmentShippedFinalizeInvoices finalizes it.</description>
        <condition><expression>statusChanged &amp;&amp; statusId == 'ShipPacked' &amp;&amp; !(['ShipShipped', 'ShipDelivered'].includes(oldStatusId))</expression></condition>
        <actions>
            <entity-find-one entity-name="mantle.shipment.Shipment" value-field="shipment"/>
            <set field="shipmentTypeEnum" from="shipment['ShipmentType#moqui.basic.Enumeration']"/>
            <if condition="shipmentTypeEnum?.enumId == 'ShpTpOutgoing' || shipmentTypeEnum?.parentEnumId == 'ShpTpOutgoing'">
                <service-call name="mantle.ledger.LedgerServices.find#PartyAcctgPreference" out-map="shipperPreference"
                        in-map="{organizationPartyId:shipment.fromPartyId}"/>
                <set field="finalizeAtShip"
                        from="shipperPreference.partyAcctgPreference?.salesInvoiceFinalizedAtShip == 'Y'"/>
                <service-call name="mantle.account.InvoiceServices.create#SalesShipmentInvoices"
                        in-map="{shipmentId:shipmentId, applyPayments:!finalizeAtShip}"/>
            </if>
        </actions>
    </seca>
    <seca id="ShipmentShippedFinalizeInvoices" service="update#mantle.shipment.Shipment" when="post-service">
        <description>On an outgoing shipment shipped (or delivered without being shipped): finalize the shipment's sales
            invoices still in process, dated the ship day, apply the order's captured payments to them and send them
            (InvoiceServices.finalize#ShipmentInvoices). Only a shipping organization with
            PartyAcctgPreference.salesInvoiceFinalizedAtShip leaves one in process at pack (D3); an invoice packed under the
            flag is finalized at ship even when the flag was turned off since.</description>
        <condition><expression>statusChanged &amp;&amp; ['ShipShipped', 'ShipDelivered'].includes(statusId) &amp;&amp;
            !(['ShipShipped', 'ShipDelivered'].includes(oldStatusId))</expression></condition>
        <actions>
            <entity-find-one entity-name="mantle.shipment.Shipment" value-field="shipment"/>
            <set field="shipmentTypeEnum" from="shipment['ShipmentType#moqui.basic.Enumeration']"/>
            <if condition="shipmentTypeEnum?.enumId == 'ShpTpOutgoing' || shipmentTypeEnum?.parentEnumId == 'ShpTpOutgoing'">
                <service-call name="mantle.account.InvoiceServices.finalize#ShipmentInvoices"
                        in-map="{shipmentId:shipmentId}"/>
            </if>
        </actions>
    </seca>
    <seca id="ShipmentIncomingDeliveredCreateInvoices" service="update#mantle.shipment.Shipment" when="post-service">
        <description>Create purchase invoice on Incoming Shipment Delivered. For a receiving organization whose
            PartyAcctgPreference.receiptInvoiceSelfBilledOnly is Y, only for a self-billing supplier (its SupplierProfile in
            effect), and then for the accepted quantity only.</description>
        <condition><expression>statusChanged &amp;&amp; statusId == 'ShipDelivered'</expression></condition>
        <actions>
            <entity-find-one entity-name="mantle.shipment.Shipment" value-field="shipment"/>
            <set field="shipmentTypeEnum" from="shipment['ShipmentType#moqui.basic.Enumeration']"/>
            <if condition="shipmentTypeEnum?.enumId == 'ShpTpIncoming' || shipmentTypeEnum?.parentEnumId == 'ShpTpIncoming'">
                <service-call name="mantle.ledger.LedgerServices.find#PartyAcctgPreference" out-map="receiverPreference"
                        in-map="{organizationPartyId:shipment.toPartyId}"/>
                <if condition="receiverPreference.partyAcctgPreference?.receiptInvoiceSelfBilledOnly == 'Y'"><then>
                    <entity-find entity-name="mantle.party.supplier.SupplierProfile" list="supplierProfileList" limit="1">
                        <date-filter/>
                        <econdition field-name="organizationPartyId" from="shipment.toPartyId"/>
                        <econdition field-name="supplierPartyId" from="shipment.fromPartyId"/>
                        <order-by field-name="-fromDate"/>
                    </entity-find>
                    <if condition="supplierProfileList[0]?.selfBillingIndicator == 'Y'">
                        <service-call name="mantle.account.InvoiceServices.create#PurchaseShipmentInvoices"
                                in-map="{shipmentId:shipmentId, acceptedOnly:true}"/></if>
                </then><else>
                    <service-call name="mantle.account.InvoiceServices.create#PurchaseShipmentInvoices"
                            in-map="{shipmentId:shipmentId}"/>
                </else></if>
            </if>
        </actions>
    </seca>

    <seca id="InvoiceCheckNegativeTotalMarkPaid" service="update#mantle.account.invoice.Invoice" when="post-service" run-on-error="false" priority="2">
        <description>Invoice Validation: Check on Finalized or Approved if invoiceTotal is less than zero;
            Invoice Auto Paid Status: On Finalized or Approved if invoiceTotal is zero then change status to Payment Received or Sent</description>
        <condition><expression>statusChanged &amp;&amp; (statusId == 'InvoiceFinalized' || statusId == 'InvoiceApproved')</expression></condition>
        <actions>
            <service-call name="mantle.account.InvoiceServices.get#InvoiceTotal" in-map="{invoiceId:invoiceId}" out-map="totalOut"/>
            <if condition="toDecimal(totalOut.invoiceTotal ?? 0).compare(0) &lt; 0"><return error="true" message="Invoice total cannot be negative (less than zero)"/></if>
            <if condition="toDecimal(totalOut.unpaidTotal ?? 0).compare(0) === 0 &amp;&amp; !(['InvoicePmtRecvd', 'InvoicePmtSent'].includes(oldStatusId))">
                <service-call name="update#mantle.account.invoice.Invoice"
                        in-map="{invoiceId:invoiceId, statusId:(statusId == 'InvoiceFinalized' ? 'InvoicePmtRecvd' : 'InvoicePmtSent')}"/>
            </if>
        </actions>
    </seca>
    <seca id="InvoiceCheckFullyPaid" service="update#mantle.account.invoice.Invoice" when="post-service" run-on-error="false" priority="2">
        <description>On Invoice Finalized to Payment Received or Approved to Payment Sent make sure is actually fully paid</description>
        <condition><expression>statusChanged &amp;&amp; ['InvoicePmtRecvd', 'InvoicePmtSent'].includes(statusId)</expression></condition>
        <!-- NOTE: could restrict more but best to cover all possible transitions: oldStatusId in ['InvoiceFinalized', 'InvoiceApproved'] &amp;&amp; -->
        <actions>
            <service-call name="mantle.account.InvoiceServices.get#InvoiceTotal" in-map="{invoiceId:invoiceId}" out-map="totalOut"/>
            <if condition="toDecimal(totalOut.unpaidTotal ?? 0).compare(0) &gt; 0"><return error="true" message="Invoice not fully paid"/></if>
        </actions>
    </seca>

    <seca id="InvoiceIssuedDueSchedule" service="update#mantle.account.invoice.Invoice" when="post-service"
            run-on-error="false" priority="3">
        <description>On Invoice Finalized or Approved write its due schedule from its term's lines, once</description>
        <condition><expression>statusChanged &amp;&amp; (statusId == 'InvoiceFinalized' || statusId == 'InvoiceApproved')
            </expression></condition>
        <actions><service-call name="mantle.account.InvoiceServices.store#InvoiceDueSchedule"
                in-map="{invoiceId:invoiceId}"/></actions>
    </seca>
    <seca id="InvoiceResumedDueSchedule" service="update#mantle.account.invoice.Invoice" when="post-service"
            run-on-error="false">
        <description>On an issued invoice changed back for edits remove its due schedule; issuing it again writes it</description>
        <condition><expression>statusChanged
            &amp;&amp; ['InvoiceFinalized', 'InvoiceSent', 'InvoiceApproved'].includes(oldStatusId)
            &amp;&amp; ['InvoiceInProcess', 'InvoiceIncoming', 'InvoiceReceived'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.account.InvoiceServices.clear#InvoiceDueSchedule"
                in-map="{invoiceId:invoiceId}"/></actions>
    </seca>
    <seca id="InvoiceApplyForPayments" service="update#mantle.account.invoice.Invoice" when="post-service" run-on-error="false" priority="3">
        <description>On Invoice Finalized or Approved look for matching Payment by forInvoiceId and auto apply</description>
        <condition><expression>statusChanged &amp;&amp; (statusId == 'InvoiceFinalized' || statusId == 'InvoiceApproved')</expression></condition>
        <actions><service-call name="mantle.account.PaymentServices.apply#InvoiceForPayments" in-map="context"/></actions>
    </seca>

    <seca id="InvoiceCancelledCleanup" service="update#mantle.account.invoice.Invoice" when="post-service" run-on-error="false">
        <description>On Invoice Cancel via direct set of statusId (entity auto service call): un-apply Payments/Invoices and other cancel cleanup</description>
        <condition><expression>statusChanged &amp;&amp; statusId == 'InvoiceCancelled'</expression></condition>
        <actions><service-call name="mantle.account.InvoiceServices.cancel#Invoice" in-map="context"/></actions>
    </seca>
    <seca id="InvoiceUnPayByStatus" service="update#mantle.account.invoice.Invoice" when="post-service" run-on-error="false">
        <description>Un-apply Payments, etc on Unpay</description>
        <condition><expression>statusChanged &amp;&amp; ['InvoicePmtRecvd', 'InvoicePmtSent'].includes(oldStatusId) &amp;&amp;
            ['InvoiceFinalized', 'InvoiceApproved'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.account.InvoiceServices.unpay#Invoice" in-map="context"/></actions>
    </seca>

    <seca id="InvoiceFinalizedSendEmail" service="update#mantle.account.invoice.Invoice" when="tx-commit">
        <description>Send Email Notice on Invoice Finalized</description>
        <condition><expression>statusChanged &amp;&amp; statusId == 'InvoiceFinalized' &amp;&amp; oldStatusId == 'InvoiceInProcess'</expression></condition>
        <actions>
            <!-- an invoice send#Invoice issued (its PDF frozen in the same transaction) has its own email -->
            <entity-find-count entity-name="mantle.account.invoice.InvoiceContent" count-field="issuedCount" disable-authz="true">
                <econdition field-name="invoiceId"/><econdition field-name="isImmutable" value="Y"/></entity-find-count>
            <if condition="!issuedCount"><service-call name="mantle.account.InvoiceServices.send#InvoiceStoreEmail"
                    in-map="{invoiceId:invoiceId, emailTypeEnumId:'PsetInvoiceFinalized'}"/></if>
        </actions>
    </seca>
</secas>
