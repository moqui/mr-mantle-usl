    <!-- Landed costs and cost data repair (impl-accounting P13; logic in ledger/AssetCosts.js) -->
    <service verb="get" noun="LandedCostSources" allow-remote="false">
        <description>A bill's lines with their totals, the account each line's posting debited and whether it was allocated
            (a freight, fee or charge line without a product, of a posted bill, not yet allocated, is a charge); the
            organization's posted inventory receipts a charge may go to (the newest 50, matching receiptText, and those
            chosen); and the bill's allocations. Refuses a bill the user may not read.</description>
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
            <parameter name="organizationPartyId"/>
            <parameter name="receiptText"/>
            <parameter name="assetReceiptIds"><description>The chosen receipts, separated by commas</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="bill" type="Map"/>
            <parameter name="chargeRows" type="List"/>
            <parameter name="receiptRows" type="List"/>
            <parameter name="allocationRows" type="List"/>
            <parameter name="canPost" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AssetCosts.js')
                    .execute('sources', context)"/>
            <set field="organizationPartyId" from="out.organizationPartyId"/>
            <set field="bill" from="out.bill"/>
            <set field="chargeRows" from="out.chargeRows"/>
            <set field="receiptRows" from="out.receiptRows"/>
            <set field="allocationRows" from="out.allocationRows"/>
            <set field="canPost" from="out.canPost"/>
        </actions>
    </service>
    <service verb="define" noun="LandedCostParameters" type="interface">
        <description>The allocation of one charge line of a bill over receipt lines.</description>
        <in-parameters>
            <parameter name="invoiceId" required="true"/>
            <parameter name="invoiceItemSeqId" required="true"/>
            <parameter name="organizationPartyId"/>
            <parameter name="assetReceiptIds"><description>Receipts separated by commas, or a list</description></parameter>
            <parameter name="basisEnumId" default-value="LcbQuantity"><description>LandedCostBasis: LcbQuantity, LcbValue,
                LcbWeight (the product's Weight, else ShippingWeight dimension) or LcbVolume</description></parameter>
            <parameter name="accountingDate" type="Date"/>
        </in-parameters>
    </service>
    <service verb="preview" noun="LandedCost" allow-remote="false">
        <description>Each receipt line's share of a charge line by the basis, split by the receipt's stock still on hand
            (raising its asset's cost, also an asset a revaluation split it into) and already issued (to cost of goods sold,
            or production variance for stock issued to work), with the accounts, the new unit costs, the findings that keep
            it from posting and the inputFingerprint post#LandedCost takes. Refuses a bill the user may not read, a line
            that is not the bill's and no receipts.</description>
        <implements service="mantle.ledger.AssetBookServices.define#LandedCostParameters"/>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="invoiceId"/>
            <parameter name="invoiceItemSeqId"/>
            <parameter name="basisEnumId"/>
            <parameter name="accountingDate"/>
            <parameter name="assetReceiptIds"/>
            <parameter name="allocationRows" type="List"/>
            <parameter name="findings" type="List"/>
            <parameter name="complete" type="Boolean"/>
            <parameter name="totalAmount" type="BigDecimal"/>
            <parameter name="amountUomId"/>
            <parameter name="chargeGlAccountId"/>
            <parameter name="inputFingerprint"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AssetCosts.js')
                    .execute('preview', context)"/>
            <set field="organizationPartyId" from="out.organizationPartyId"/>
            <set field="invoiceId" from="out.invoiceId"/>
            <set field="invoiceItemSeqId" from="out.invoiceItemSeqId"/>
            <set field="basisEnumId" from="out.basisEnumId"/>
            <set field="accountingDate" from="out.accountingDate"/>
            <set field="assetReceiptIds" from="out.assetReceiptIds"/>
            <set field="allocationRows" from="out.allocationRows"/>
            <set field="findings" from="out.findings"/>
            <set field="complete" from="out.complete"/>
            <set field="totalAmount" from="out.totalAmount"/>
            <set field="amountUomId" from="out.amountUomId"/>
            <set field="chargeGlAccountId" from="out.chargeGlAccountId"/>
            <set field="inputFingerprint" from="out.inputFingerprint"/>
        </actions>
    </service>
    <service verb="post" noun="LandedCost" allow-remote="false">
        <description>Post a previewed landed cost (ACCOUNTING_GL_POST): one transaction debiting the inventory account of
            each asset holding the receipts' stock with its on-hand share and cost of goods sold or production variance
            with the issued share, crediting the charge line's account; the assets' cost rises from the accounting date,
            each with an AssetBookEvent, and a LandedCostAllocation row is kept for each receipt. A retry with the same
            operation key answers the first result. Refuses a user without GL posting, no reason, a stale preview, a line
            already allocated, findings, a closed period and a posting the ledger refuses.</description>
        <implements service="mantle.ledger.AssetBookServices.define#LandedCostParameters"/>
        <in-parameters>
            <parameter name="inputFingerprint" required="true"/>
            <parameter name="operationKey" required="true"/>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="acctgTransId"/>
            <parameter name="landedCostAllocationIds" type="List"/>
            <parameter name="totalAmount"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AssetCosts.js')
                    .execute('post', context)"/>
            <set field="acctgTransId" from="out.acctgTransId"/>
            <set field="landedCostAllocationIds" from="out.landedCostAllocationIds"/>
            <set field="totalAmount" from="out.totalAmount"/>
            <set field="alreadyApplied" from="!!out.alreadyApplied"/>
        </actions>
    </service>
    <service verb="repair" noun="ProductAcquireCost" allow-remote="false" transaction-timeout="600">
        <description>Cost data repair (finance administration, ACCOUNTING_ADMIN): set the acquire cost of the organization's
            inventory assets of a product (and facility) and repost their receipts, issues and count variances
            (AssetServices.update#AssetAcquireCost), each asset's change kept as an AssetBookEvent with the reason. A retry
            with the same operation key answers the first result. Refuses a user without finance administration, no
            reason, a negative cost, no inventory of the product, and any posted transaction of those assets in a closed
            period.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId" required="true"/>
            <parameter name="facilityId"/>
            <parameter name="acquireCost" type="BigDecimal" required="true"/>
            <parameter name="changeReason" required="true"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="repairedCount" type="Integer"/>
            <parameter name="assetIds" type="List"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AssetCosts.js')
                    .execute('repair', context)"/>
            <set field="repairedCount" from="out.repairedCount"/>
            <set field="assetIds" from="out.assetIds"/>
            <set field="alreadyApplied" from="!!out.alreadyApplied"/>

    <!-- Fixed asset books (impl-accounting P12, design-accounting §10; logic in FixedAssets.js): class defaults, the book
        events of an asset and depreciation as a kind of period run. The organization is the asset's owner. -->
    <service verb="store" noun="Class" allow-remote="false">
        <description>Start a dated version of an organization's book defaults for an asset class (ACCOUNTING_ADMIN): useful
            life, residual percent, book and tax methods and accounts. Given the version it replaces (fixedAssetClassId),
            the new one starts at fromDate and the old one ends there; given only that version and a thruDate, it ends the
            version. Key fields are audit-logged with the change reason. Refuses a class that is not an AssetClass, a type
            that is not a fixed asset type, a life outside 1 to 100 years, a residual outside 0 to 99 percent, a missing
            method, an account not assigned to the organization, dates that do not follow, an overlapping version
            (CLASS_OVERLAP) and a missing reason.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="fixedAssetClassId"/>
            <parameter name="classEnumId"/>
            <parameter name="assetTypeEnumId"/>
            <parameter name="description"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="usefulLifeYears" type="Integer"/>
            <parameter name="salvagePercent" type="BigDecimal"/>
            <parameter name="depreciationTypeEnumId"/>
            <parameter name="taxDepreciationTypeEnumId"/>
            <parameter name="assetGlAccountId"/>
            <parameter name="accDepreciationGlAccountId"/>
            <parameter name="depreciationGlAccountId"/>
            <parameter name="gainGlAccountId"/>
            <parameter name="lossGlAccountId"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fixedAssetClassId"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('storeClass', context)"/>
            <set field="fixedAssetClassId" from="answer.fixedAssetClassId"/>
        </actions>
    </service>
    <service verb="capitalize" noun="Asset" allow-remote="false">
        <description>Put a fixed asset in service on the books (ACCOUNTING_GL_POST in its owner organization): its
            class's version in effect on the in-service day fills what is not given (useful life, residual, method,
            accounts), the asset takes that basis and its own account row, and an asset not received posts its cost from
            the offset account given, else the Unreceived Fixed Asset clearing account (a received one is on the books from
            its receipt, reclassified when the class's asset account differs; one whose receipt has not posted is refused,
            RECEIPT_NOT_POSTED). Writes an AbeCapitalize book event; a retry with the same operation key
            answers the first. Refuses a closed period, an asset already capitalized or disposed, another currency, a
            received asset's cost changed here (COST_FROM_RECEIPT), a source that is not the asset's receipt or the
            organization's bill, and missing accounts.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="classEnumId"/>
            <parameter name="inServiceDate" type="Date"/>
            <parameter name="acquireCost" type="BigDecimal"/>
            <parameter name="acquireCostUomId"/>
            <parameter name="usefulLifeYears" type="Integer"/>
            <parameter name="salvageValue" type="BigDecimal"/>
            <parameter name="depreciationTypeEnumId"/>
            <parameter name="assetGlAccountId"/>
            <parameter name="accDepreciationGlAccountId"/>
            <parameter name="depreciationGlAccountId"/>
            <parameter name="sourceInvoiceId"/>
            <parameter name="sourceAssetReceiptId"/>
            <parameter name="offsetGlAccountId"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetBookEventId"/>
            <parameter name="acctgTransId"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('capitalize', context)"/>
            <set field="assetBookEventId" from="answer.assetBookEventId"/>
            <set field="acctgTransId" from="answer.acctgTransId"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="adjust" noun="AssetBook" allow-remote="false">
        <description>Change a capitalized asset's book basis from a day forward (ACCOUNTING_GL_POST): a change in cost
            posts against the Unreceived Fixed Asset clearing account, a change in useful life moves its end, a change in
            residual its salvage value; later depreciation uses the new basis. A received asset's change of cost needs the
            offset account it comes from (OFFSET_REQUIRED). Writes an AbeAdjust book event with the net
            book before and after. Refuses a closed period, an asset not capitalized or disposed, no change, a day before
            posted depreciation (DEPRECIATED_AFTER), a residual not below the cost, a cost below the depreciation posted
            (BOOK_NEGATIVE), a life ending by the day and a missing reason.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="effectiveDate" type="Date"/>
            <parameter name="costChange" type="BigDecimal"/>
            <parameter name="usefulLifeChange" type="Integer"/>
            <parameter name="salvageChange" type="BigDecimal"/>
            <parameter name="offsetGlAccountId"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetBookEventId"/>
            <parameter name="acctgTransId"/>
            <parameter name="netBookBefore" type="BigDecimal"/>
            <parameter name="netBookAfter" type="BigDecimal"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('adjust', context)"/>
            <set field="assetBookEventId" from="answer.assetBookEventId"/>
            <set field="acctgTransId" from="answer.acctgTransId"/>
            <set field="netBookBefore" from="answer.netBookBefore"/>
            <set field="netBookAfter" from="answer.netBookAfter"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="dispose" noun="Asset" allow-remote="false">
        <description>Scrap or sell a capitalized asset (ACCOUNTING_GL_POST): its cost and accumulated depreciation leave
            the books, a sale's proceeds go to the clearing account its invoice line credits (the asset's Unissued Fixed
            Asset account), and the difference posts as a gain or a loss; the asset ends its life on the day and is kept.
            Writes an AbeDispose book event. Refuses a closed period, an asset not capitalized or already disposed, a day
            before it went in service or before posted depreciation, a month before the disposal not yet depreciated
            (DEPRECIATION_DUE), an invoice without a line to the clearing account, a sale without proceeds, proceeds on a
            scrap, an invoice that is not the organization's to the buyer or that sells the asset itself
            (ASSET_SOLD_BY_INVOICE) and a missing reason.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="disposalDate" type="Date"/>
            <parameter name="disposalTypeEnumId"/>
            <parameter name="proceedsAmount" type="BigDecimal"/>
            <parameter name="buyerPartyId"/>
            <parameter name="salesInvoiceId"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetBookEventId"/>
            <parameter name="acctgTransId"/>
            <parameter name="gainLossAmount" type="BigDecimal"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('dispose', context)"/>
            <set field="assetBookEventId" from="answer.assetBookEventId"/>
            <set field="acctgTransId" from="answer.acctgTransId"/>
            <set field="gainLossAmount" from="answer.gainLossAmount"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="reverse" noun="AssetBookEvent" allow-remote="false">
        <description>Reverse an asset's latest capitalization, adjustment or disposal in force
            (ACCOUNTING_GL_POST): a dated reversal of its posting in an open period, and the asset's book basis and accounts
            as they were before it. Writes an AbeReversal book event linked to it. Refuses another kind of event, one
            already reversed, one with a later event in force (EVENT_NOT_LATEST), a capitalization or adjustment that
            depreciation has used since (EVENT_DEPRECIATED), a day before the event or in a closed period and a missing
            reason.</description>
        <in-parameters>
            <parameter name="assetBookEventId" required="true"/>
            <parameter name="reversalDate" type="Date"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetBookEventId"/>
            <parameter name="acctgTransId"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('reverse', context)"/>
            <set field="assetBookEventId" from="answer.assetBookEventId"/>
            <set field="acctgTransId" from="answer.acctgTransId"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="repair" noun="AcquireCost" allow-remote="false">
        <description>Rewrite one asset's acquire cost as audited data repair (ACCOUNTING_ADMIN), through
            mantle.product.AssetServices.update#AssetAcquireCost, which reposts its receipts, issuances and counts: only
            while every posted transaction of the asset is in an open period (F39), and never on a capitalized asset
            (ASSET_CAPITALIZED: adjust the book) or a disposed one. Writes an AbeCostRepair book event with
            the old and new cost. Refuses a period closed for any of its postings (PERIOD_CLOSED), a cost that is not
            positive and a missing reason.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="acquireCost" type="BigDecimal"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="assetBookEventId"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('repairCost', context)"/>
            <set field="assetBookEventId" from="answer.assetBookEventId"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="get" noun="AssetBook" allow-remote="false">
        <description>A fixed asset's book for EquipmentDetail, for a user with Accounting read authority in its owner
            organization: its identity, book basis, accumulated depreciation and net book, its accounts, its class's
            defaults in effect today, its book events (with which may be reversed), its depreciation by period and its
            receipts, each with its transaction, and what the user may do. Refuses another organization's asset
            (ASSET_UNAVAILABLE) and an asset that is not a fixed asset.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="asset" type="Map"/>
            <parameter name="accounts" type="List"/>
            <parameter name="classDefaults" type="Map"/>
            <parameter name="events" type="List"/>
            <parameter name="depreciations" type="List"/>
            <parameter name="receipts" type="List"/>
            <parameter name="canCapitalize" type="Boolean"/>
            <parameter name="canAdjust" type="Boolean"/>
            <parameter name="canDispose" type="Boolean"/>
            <parameter name="canRepair" type="Boolean"/>
            <parameter name="canPostLedger" type="Boolean"/>
            <parameter name="periodOpen" type="Boolean"/>
        </out-parameters>
        <actions>
