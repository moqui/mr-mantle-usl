    <service verb="preview" noun="Depreciation" allow-remote="false">
        <description>Preview a fiscal month's depreciation of the organization's fixed assets
            (ACCOUNTING_GL_POST), all of them or those of a class or chosen: a period run of kind PrkDepreciation
            (PeriodRunServices.preview#Run), one result per asset not yet depreciated for the month, an asset that cannot
            be computed a failed result. Refuses a closed period and a period that is not a fiscal month.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="timePeriodId" required="true"/>
            <parameter name="effectiveDate" type="Date"/>
            <parameter name="classEnumId"/>
            <parameter name="assetIdList" type="List"/>
        </in-parameters>
        <out-parameters>
            <parameter name="periodRunId"/>
            <parameter name="calculationVersion"/>
            <parameter name="resultCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="totalAmount" type="BigDecimal"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('previewDepreciation', context)"/>
            <set field="periodRunId" from="answer.periodRunId"/>
            <set field="calculationVersion" from="answer.calculationVersion"/>
            <set field="resultCount" from="answer.resultCount"/>
            <set field="failedCount" from="answer.failedCount"/>
            <set field="totalAmount" from="answer.totalAmount"/>
        </actions>
    </service>
    <service verb="get" noun="DepreciationPreview" allow-remote="false">
        <description>A depreciation run (PeriodRunServices.get#Run) with each asset's cost, residual,
            depreciation before the period, the period's amount and the net book after it. Refuses a user without Accounting
            read authority in the run's organization and a run of another kind.</description>
        <in-parameters>
            <parameter name="periodRunId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="run" type="Map"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('depreciationPreview', context)"/>
            <set field="run" from="answer.run"/>
            <set field="results" from="answer.results"/>
        </actions>
    </service>
    <service verb="post" noun="Depreciation" allow-remote="false">
        <description>Post a reviewed depreciation run (ACCOUNTING_GL_POST) through PeriodRunServices.post#Run: each
            asset-period once, each in its own transaction with its depreciation row, an asset that does not post a failed
            result with no row. Refuses a run of another kind, a changed run (RUN_CHANGED) and a closed period.</description>
        <in-parameters>
            <parameter name="periodRunId" required="true"/>
            <parameter name="calculationVersion" required="true"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="statusId"/>
            <parameter name="postedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('postDepreciation', context)"/>
            <set field="statusId" from="answer.statusId"/>
            <set field="postedCount" from="answer.postedCount"/>
            <set field="failedCount" from="answer.failedCount"/>
            <set field="alreadyApplied" from="answer.alreadyApplied"/>
        </actions>
    </service>
    <service verb="calculate" noun="DepreciationRun" allow-remote="false">
        <description>The depreciation period run's results (PeriodRunKind PrkDepreciation): the
            organization's fixed assets with a method, in service by the month's end, not disposed by it and not yet
            depreciated for it, each with the month's amount (calculate#FixedAssetDepreciation) and accounts, or why it
            cannot be computed. Called by PeriodRunServices.preview#Run and post#Run, which check the permission.</description>
        <implements service="mantle.ledger.PeriodRunServices.define#RunCalculation"/>
        <out-parameters>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('calculateRun', context)"/>
            <set field="results" from="answer.results"/>
        </actions>
    </service>
    <service verb="post" noun="DepreciationRun" allow-remote="false">
        <description>Post a previewed depreciation run: each ready result's asset through
            post#AssetPeriodDepreciation in its own transaction, posted or failed with its reason. Called by
            PeriodRunServices.post#Run.</description>
