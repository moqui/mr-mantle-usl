            <parameter name="postedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('postRun', context)"/>
            <set field="postedCount" from="answer.postedCount"/>
            <set field="failedCount" from="answer.failedCount"/>
        </actions>
    </service>
    <service verb="post" noun="AssetPeriodDepreciation" allow-remote="false">
        <description>One asset's depreciation for a fiscal month, through
            AssetAutoPostServices.calculateAndPost#FixedAssetDepreciation, with its depreciation row: refused when the asset
            is already depreciated for the month, has nothing to post or its transaction did not post, so the caller's
            transaction rolls back and leaves no row (F38). Called in a new transaction by post#DepreciationRun.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="timePeriodId" required="true"/>
            <parameter name="transactionDate" type="Timestamp"/>
            <parameter name="expectedAmount" type="BigDecimal"/>
        </in-parameters>
        <out-parameters>
            <parameter name="acctgTransId"/>
        </out-parameters>
        <actions>
            <set field="answer" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/FixedAssets.js')
                    .execute('postAssetPeriod', context)"/>
            <set field="acctgTransId" from="answer.acctgTransId"/>
        </actions>
    </service>
</services>
