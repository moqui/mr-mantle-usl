<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="store" noun="Lock" allow-remote="false">
        <description>Create or change an organization posting lock of a scope (all, sales, purchases or tax) through a
            date. Refuses a user without finance administration, a lock of another organization, a stale revision and
            relaxing a hard lock (softening it, changing its scope or moving its date back).</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="accountingLockId"/>
            <parameter name="lockScope"/>
            <parameter name="lockThroughDate" type="Date"/>
            <parameter name="isHard"/>
            <parameter name="changeReason"/>
            <parameter name="lastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="accountingLockId"/>
        </out-parameters>
        <actions>
            <set field="policy" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingPolicy.js')"/>
            <set field="scope" from="policy.organization(context, 'admin')"/>
            <set field="changeReason" from="policy.reason(context)"/>
            <set field="lockDateValid" from="Number.isFinite(policy.ms(lockThroughDate))"/>
            <if condition="!['all', 'sales', 'purchases', 'tax'].includes(lockScope) || !lockDateValid">
                <return error="true" message="Choose a lock scope and date"/>
            </if>
            <entity-find-one entity-name="mantle.party.Party" value-field="organization" for-update="true" disable-authz="true">
                <field-map field-name="partyId" from="scope.organizationPartyId"/>
            </entity-find-one>
            <if condition="accountingLockId">
                <entity-find-one entity-name="mantle.ledger.config.AccountingLock" value-field="oldLock" for-update="true"
                        disable-authz="true">
                    <field-map field-name="accountingLockId"/>
                </entity-find-one>
                <if condition="oldLock?.organizationPartyId !== scope.organizationPartyId">
                    <return error="true" message="Posting lock is not available"/>
                </if>
                <script>policy.revision(oldLock, lastUpdatedStamp)</script>
                <set field="relaxed" from="isHard !== 'Y' || oldLock.lockScope !== lockScope ||
                        policy.ms(lockThroughDate) &lt; policy.ms(oldLock.lockThroughDate)"/>
                <if condition="oldLock.isHard === 'Y' &amp;&amp; relaxed">
                    <return error="true" message="A hard lock cannot be relaxed"/>
                </if>
            </if>
            <set field="lockValues" from="{organizationPartyId:scope.organizationPartyId, lockScope:lockScope,
                    lockThroughDate:lockThroughDate, isHard:isHard === 'Y' ? 'Y' : 'N', changeReason:changeReason,
                    changedByUserId:ec.user.userId}"/>
            <script>policy.audit(Object.keys(lockValues), changeReason)</script>
            <if condition="oldLock">
                <then>
                    <service-call name="update#mantle.ledger.config.AccountingLock" disable-authz="true"
                            in-map="Object.assign({accountingLockId:oldLock.accountingLockId}, lockValues)"/>
                </then>
                <else>
                    <service-call name="create#mantle.ledger.config.AccountingLock" in-map="lockValues" out-map="context"
                            disable-authz="true"/>
                </else>
            </if>
        </actions>
    </service>
    <service verb="grant" noun="Exception" allow-remote="false">
        <description>Grant one user or group a named, expiring exception to a soft lock, optionally for one journal entry.
            Refuses a user without finance administration, a hard lock or one of another organization, both or neither
            of user and group, an expiry not in the future, and an unknown user, group or journal entry. An exception
            never opens a closed fiscal period.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="accountingLockId"/>
            <parameter name="userId"/>
            <parameter name="userGroupId"/>
            <parameter name="acctgTransId"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="accountingLockExceptionId"/>
        </out-parameters>
        <actions>
            <set field="policy" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingPolicy.js')"/>
            <set field="scope" from="policy.organization(context, 'admin')"/>
            <set field="changeReason" from="policy.reason(context)"/>
            <entity-find-one entity-name="mantle.party.Party" value-field="organization" for-update="true" disable-authz="true">
                <field-map field-name="partyId" from="scope.organizationPartyId"/>
            </entity-find-one>
            <entity-find-one entity-name="mantle.ledger.config.AccountingLock" value-field="softLock" for-update="true"
                    disable-authz="true">
                <field-map field-name="accountingLockId"/>
            </entity-find-one>
            <if condition="softLock?.organizationPartyId !== scope.organizationPartyId || softLock.isHard === 'Y'">
                <return error="true" message="Choose a soft lock in this organization"/>
            </if>
            <set field="expiryPassed" from="!thruDate || policy.ms(thruDate) &lt;= policy.ms(ec.user.nowTimestamp)"/>
            <if condition="!!userId === !!userGroupId || expiryPassed">
                <return error="true" message="Choose one user or group and a future expiry"/>
            </if>
            <if condition="userId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="actor" disable-authz="true">
                    <field-map field-name="userId"/>
                </entity-find-one>
            </if>
            <if condition="userGroupId">
                <entity-find-one entity-name="moqui.security.UserGroup" value-field="actor" disable-authz="true">
                    <field-map field-name="userGroupId"/>
                </entity-find-one>
            </if>
            <if condition="actor == null">
                <return error="true" message="Exception actor is not available"/>
            </if>
            <if condition="acctgTransId">
                <script>policy.record({kind:'journals', recordId:acctgTransId,
                    organizationPartyId:scope.organizationPartyId})</script>
            </if>
            <service-call name="create#mantle.ledger.config.AccountingLockException" out-map="context" disable-authz="true"
                    in-map="{accountingLockId:softLock.accountingLockId, organizationPartyId:scope.organizationPartyId,
                        userId:userId, userGroupId:userGroupId, acctgTransId:acctgTransId, lockScope:softLock.lockScope,
                        fromDate:ec.user.nowTimestamp, thruDate:thruDate, changeReason:changeReason,
                        approvedByUserId:ec.user.userId}"/>
        </actions>
    </service>
    <service verb="define" noun="CloseCheck" type="interface">
        <description>A row of the period close checklist (a PeriodCloseCheck enumeration names its service): the period's
            items of its kind for the organization and the organizations that roll up to it. Each item names the record
            that resolves it: recordKind (invoices, bills, payments, journals, banks, periods, assets, workEfforts,
            timeEntries or a kind the source documents), recordId, text and detail.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="timePeriodId" required="true"/>
            <parameter name="checkEnumId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="count" type="Integer"/>
            <parameter name="items" type="List"/>
        </out-parameters>
    </service>
    <service verb="check" noun="StandardClose" allow-remote="false">
        <description>Mantle's checklist rows (CloseServices.define#CloseCheck): unposted transactions, the error journal,
            unbalanced transactions, unposted documents, bank lines not on a finished statement, missing rates, bills on
            hold, stock movements that posted nothing, open WIP and unposted project time. Refuses a user who may not read
            the organization's periods.</description>
        <implements service="mantle.ledger.CloseServices.define#CloseCheck"/>
        <actions>
            <set field="checked" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/PeriodClose.js')
                    .execute('standardCheck', context)"/>
            <set field="count" from="checked.count"/>
            <set field="items" from="checked.items"/>
        </actions>
    </service>
    <service verb="get" noun="Checklist" allow-remote="false">
        <description>What keeps an organization's fiscal period from closing: its dates and order (ended, previous period
            and child periods closed), then each PeriodCloseCheck row in order with its count and up to 20 named items. A
            row that blocks has items and optionIndicator Y; a row whose check fails is unavailable, which blocks too. Also
            whether the user may close or reopen it, and its close runs. Refuses a user who may not read the
            organization's periods, and a period of another organization.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="timePeriodId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="period" type="Map"/>
            <parameter name="checkRows" type="List"/>
            <parameter name="blockerCount" type="Integer"/>
            <parameter name="canClose" type="Boolean"/>
            <parameter name="canReopen" type="Boolean"/>
            <parameter name="closeRuns" type="List"/>
        </out-parameters>
        <actions>
            <set field="checked" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/PeriodClose.js')
                    .execute('checklist', context)"/>
            <set field="period" from="checked.period"/>
            <set field="checkRows" from="checked.checkRows"/>
            <set field="blockerCount" from="checked.blockerCount"/>
            <set field="canClose" from="checked.canClose"/>
            <set field="canReopen" from="checked.canReopen"/>
            <set field="closeRuns" from="checked.closeRuns"/>
        </actions>
    </service>
    <service verb="close" noun="Period" allow-remote="false">
        <description>Close an organization's fiscal period (FISCAL_CLOSE) in one transaction: under the period's lock the
            checklist again, refused (CLOSE_BLOCKED) naming each blocked or unavailable row; then Mantle's
            close#FinancialTimePeriod, the period's GL summary rows computed from its postings and stored (creating any
            that are missing), for a fiscal year the closing entries to the organization's net income account, and an
            AccountingCloseRun with the checklist it passed. Refuses a period already closed and a period of another
            organization. A retry with the same operation key answers the first close.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="timePeriodId" required="true"/>
            <parameter name="changeReason"/>
            <parameter name="netIncomeGlAccountId"/>
            <parameter name="operationKey"/>
        </in-parameters>
        <out-parameters>
            <parameter name="closeRunId"/>
            <parameter name="closingAcctgTransIdList" type="List"/>
            <parameter name="summaryAccountCount" type="Integer"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="closed" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/PeriodClose.js')
                    .execute('close', context)"/>
            <set field="closeRunId" from="closed.closeRunId"/>
            <set field="closingAcctgTransIdList" from="closed.closingAcctgTransIdList"/>
            <set field="summaryAccountCount" from="closed.summaryAccountCount"/>
            <set field="alreadyApplied" from="!!closed.alreadyApplied"/>
        </actions>
    </service>
    <service verb="reopen" noun="Period" allow-remote="false">
        <description>Reopen a closed fiscal period with a reason (FISCAL_REOPEN), through Mantle's
            reopen#FinancialTimePeriod, which refuses while the next or the parent period is closed. The period's close
            run is kept and marked reopened, with who reopened it, when and why (audit-logged).</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="timePeriodId" required="true"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="closeRunId"/>
        </out-parameters>
        <actions>
            <set field="reopened" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/PeriodClose.js')
                    .execute('reopen', context)"/>
            <set field="closeRunId" from="reopened.closeRunId"/>
        </actions>
    </service>
</services>
