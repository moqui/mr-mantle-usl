<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="store" noun="Rate" allow-remote="false">
        <description>Store a dated currency rate labelled with its source. The rate in effect at its start ends there, and
            with no end of its own it ends where the next dated rate starts. The same rate stored again answers
            alreadyStored. Refuses a user without finance administration, a unit that is not a currency, the same
            currency twice, a factor that is not positive, a missing start or source, an end not after the start,
            another rate starting at the same time and an end past the next rate's start.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="uomId"/>
            <parameter name="toUomId"/>
            <parameter name="conversionFactor" type="BigDecimal"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="rateSource"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="uomConversionId"/>
            <parameter name="alreadyStored" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="policy" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingPolicy.js')"/>
            <script>policy.organization(context, 'admin')</script>
            <set field="changeReason" from="policy.reason(context)"/>
            <script>policy.currency(uomId)</script>
            <script>policy.currency(toUomId)</script>
            <set field="factorPositive" from="conversionFactor != null &amp;&amp; toDecimal(conversionFactor).compare(0) &gt; 0"/>
            <set field="startValid" from="Number.isFinite(policy.ms(fromDate))"/>
            <if condition="uomId === toUomId || !factorPositive || !startValid || !String(rateSource || '').trim()">
                <return error="true" message="Choose distinct currencies, a positive factor, an effective date and source"/>
            </if>
            <if condition="thruDate &amp;&amp; policy.ms(thruDate) &lt;= policy.ms(fromDate)">
                <return error="true" message="Rate end must follow its start"/>
            </if>
            <!-- lock both currencies in one order, so two writers of a pair wait instead of deadlocking -->
            <iterate list="[uomId, toUomId].sort()" entry="lockUomId">
                <entity-find-one entity-name="moqui.basic.Uom" value-field="lockedUom" for-update="true" disable-authz="true">
                    <field-map field-name="uomId" from="lockUomId"/>
                </entity-find-one>
            </iterate>
            <entity-find entity-name="moqui.basic.UomConversion" list="sameStartRates" limit="1" disable-authz="true">
                <econdition field-name="uomId"/>
                <econdition field-name="toUomId"/>
                <econdition field-name="fromDate"/>
            </entity-find>
            <set field="sameStartRate" from="Array.from(sameStartRates)[0]"/>
            <if condition="sameStartRate">
                <set field="sameRate" from="toDecimal(sameStartRate.conversionFactor).eq(conversionFactor) &amp;&amp;
                        sameStartRate.rateSource === rateSource &amp;&amp;
                        policy.ms(sameStartRate.thruDate) === policy.ms(thruDate)"/>
                <if condition="!sameRate">
                    <return error="true" message="A rate already starts at this time; preserve it and choose a later date"/>
                </if>
                <set field="uomConversionId" from="sameStartRate.uomConversionId"/>
                <set field="alreadyStored" from="true"/>
                <return/>
            </if>
            <entity-find entity-name="moqui.basic.UomConversion" list="laterRates" limit="1" disable-authz="true">
                <econdition field-name="uomId"/>
                <econdition field-name="toUomId"/>
                <econdition field-name="fromDate" operator="greater" from="fromDate"/>
                <order-by field-name="fromDate"/>
            </entity-find>
            <set field="nextRate" from="Array.from(laterRates)[0]"/>
            <if condition="nextRate &amp;&amp; thruDate &amp;&amp; policy.ms(thruDate) &gt; policy.ms(nextRate.fromDate)">
                <return error="true" message="Rate overlaps a future dated rate"/>
            </if>
            <!-- no rate starts at fromDate (checked above), so the one in effect then started before it -->
            <entity-find entity-name="moqui.basic.UomConversion" list="currentRates" limit="1" disable-authz="true">
                <econdition field-name="uomId"/>
                <econdition field-name="toUomId"/>
                <date-filter valid-date="fromDate"/>
            </entity-find>
            <set field="currentRate" from="Array.from(currentRates)[0]"/>
            <script>policy.audit(['fromDate', 'thruDate', 'conversionFactor', 'rateSource'], changeReason)</script>
            <if condition="currentRate">
                <service-call name="update#moqui.basic.UomConversion" disable-authz="true"
                        in-map="{uomConversionId:currentRate.uomConversionId, thruDate:fromDate}"/>
            </if>
            <service-call name="create#moqui.basic.UomConversion" out-map="context" disable-authz="true"
                    in-map="{uomId:uomId, toUomId:toUomId, conversionFactor:conversionFactor, conversionOffset:0,
                        fromDate:fromDate, thruDate:thruDate || nextRate?.fromDate, rateSource:rateSource}"/>
        </actions>
    </service>
    <service verb="store" noun="Currency" allow-remote="false">
        <description>Create a currency unit or change its name and decimals. Refuses a user without finance
            administration, a code that is not three capital letters, a missing name, decimals outside 0 to 6, a unit
            that is not a currency, a stale revision and a change of decimals of a currency with posted
            entries.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="uomId"/>
            <parameter name="description"/>
            <parameter name="fractionDigits" type="Integer"/>
            <parameter name="changeReason"/>
            <parameter name="lastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="policy" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingPolicy.js')"/>
            <script>policy.organization(context, 'admin')</script>
            <set field="changeReason" from="policy.reason(context)"/>
            <set field="digits" from="Number(fractionDigits)"/>
            <set field="digitsValid" from="Number.isInteger(digits) &amp;&amp; digits &gt;= 0 &amp;&amp; digits &lt;= 6"/>
            <if condition="!/^[A-Z]{3}$/.test(uomId || '') || !description || !digitsValid">
                <return error="true" message="Supply a three-letter currency code, name and 0–6 decimals"/>
            </if>
            <entity-find-one entity-name="moqui.basic.Uom" value-field="oldUom" for-update="true" disable-authz="true">
                <field-map field-name="uomId"/>
            </entity-find-one>
            <if condition="oldUom">
                <script>policy.currency(uomId)</script>
                <script>policy.revision(oldUom, lastUpdatedStamp)</script>
                <if condition="Number(oldUom.fractionDigits) !== digits">
                    <entity-find-count entity-name="mantle.ledger.transaction.AcctgTrans" count-field="postedCount"
                            disable-authz="true">
                        <econdition field-name="amountUomId" from="uomId"/>
                        <econdition field-name="isPosted" value="Y"/>
                    </entity-find-count>
                    <if condition="postedCount &gt; 0">
                        <return error="true" message="Posted currency precision requires a migration"/>
                    </if>
                </if>
            </if>
            <script>policy.audit(['description', 'fractionDigits'], changeReason)</script>
            <set field="uomValues" from="{uomId:uomId, uomTypeEnumId:'UT_CURRENCY_MEASURE', description:description,
                    abbreviation:uomId, fractionDigits:digits}"/>
            <if condition="oldUom">
                <then>
                    <service-call name="update#moqui.basic.Uom" in-map="uomValues" disable-authz="true"/>
                </then>
                <else>
                    <service-call name="create#moqui.basic.Uom" in-map="uomValues" disable-authz="true"/>
                </else>
            </if>
            <set field="complete" from="true"/>
        </actions>
    </service>
    <service verb="import" noun="Rates" allow-remote="false">
        <description>Import a CSV of rates (uomId, toUomId, fromDate, thruDate, conversionFactor, rateSource), each row
            stored by store#Rate in its own transaction; a failed row is named in the results and the others go on.
            Refuses a user without finance administration, a file over 2 MiB or 5,000 rows and unknown, missing or
            repeated headers.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="csvText"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="importId"/>
            <parameter name="results" type="List"/>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                .execute('importRates', context))</script>
        </actions>
    </service>
    <!-- ========== Provider rates (AC-16): proposed by refresh#Rates, active once a finance user accepts them ========== -->
    <service verb="define" noun="RateProvider" type="interface">
        <description>An exchange rate provider: the rates of one currency (fromUomId) in others, for one day. Named by an
            ExchangeRateProvider enumeration's enumCode, which PartyAcctgPreference.rateProviderServiceName holds.</description>
        <in-parameters>
            <parameter name="sourceText" allow-html="any"><description>The provider's file, already fetched (an upload
                where the server has no outbound access); without it the provider fetches its own.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="fromUomId"><description>The currency the rates are of: one fromUomId is rate uomId</description>
            </parameter>
            <parameter name="rateDay"><description>The day the rates are for, yyyy-MM-dd</description></parameter>
            <parameter name="rates" type="List"><description>Maps of uomId and rate (decimal text)</description></parameter>
            <parameter name="rateSource"/>
        </out-parameters>
    </service>
    <service verb="get" noun="EcbRates" allow-remote="false">
        <description>The European Central Bank's daily euro reference rates (free, no key), from its daily file or the
            copy given. Refuses a file over 1 MiB or without its day or rates, and an answer of the bank that is not a
            success.</description>
        <implements service="mantle.ledger.CurrencyServices.define#RateProvider"/>
        <out-parameters>
            <parameter name="fromUomId"/>
            <parameter name="rateDay"/>
            <parameter name="rates" type="List"/>
            <parameter name="rateSource"/>
        </out-parameters>
        <actions>
            <set field="fetched" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('ecbRates', context)"/>
            <set field="fromUomId" from="fetched.fromUomId"/>
            <set field="rateDay" from="fetched.rateDay"/>
            <set field="rates" from="fetched.rates"/>
            <set field="rateSource" from="fetched.rateSource"/>
        </actions>
    </service>
    <service verb="refresh" noun="Rates" allow-remote="false">
        <description>Ask the organization's rate provider (rateProviderServiceName) for the day's rates and propose a rate
            to the base currency for each currency the organization deals in (its invoices and payments), or each of
            uomIdList: a cross rate through the provider's currency. A proposal is not active until accept#RateProposals;
            the same pair and day proposed or accepted before answers that proposal. Refuses a user without finance
            administration, no base currency, no provider or one that is not an ExchangeRateProvider, and a provider without
            the base currency.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="uomIdList" type="List"/>
            <parameter name="sourceText" allow-html="any"><description>The provider's file, uploaded instead of
                fetched; read, never shown</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="proposals" type="List"/>
            <parameter name="skippedUomIds" type="List"/>
            <parameter name="rateDay"/>
        </out-parameters>
        <actions>
            <set field="refreshed" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('refreshRates', context)"/>
            <set field="proposals" from="refreshed.proposals"/>
            <set field="skippedUomIds" from="refreshed.skippedUomIds"/>
            <set field="rateDay" from="refreshed.rateDay"/>
        </actions>
    </service>
    <service verb="get" noun="RateProposals" allow-remote="false">
        <description>The organization's proposed rates still to decide, by day and currency, at most 200. Refuses a user
            without finance administration.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="proposals" type="List"/>
        </out-parameters>
        <actions>
            <set field="proposals" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('getProposals', context).proposals"/>
        </actions>
    </service>
    <service verb="accept" noun="RateProposals" allow-remote="false">
        <description>Accept proposed rates: each becomes an active dated rate through store#Rate, in its own transaction; a
            refused one (decided already, another organization's, or a rate already starting then) is named in the results
            and the others go on. Refuses a user without finance administration and an empty selection.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="rateProposalIdList" type="List"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="decided" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('acceptProposals', context)"/>
            <set field="results" from="decided.results"/>
            <set field="complete" from="decided.complete"/>
        </actions>
    </service>
    <service verb="reject" noun="RateProposals" allow-remote="false">
        <description>Reject proposed rates, each in its own transaction; a refused one is named in the results. Refuses a
            user without finance administration and an empty selection.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="rateProposalIdList" type="List"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="decided" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('rejectProposals', context)"/>
            <set field="results" from="decided.results"/>
            <set field="complete" from="decided.complete"/>
        </actions>
    </service>
    <service verb="decide" noun="RateProposal" allow-remote="false">
        <description>One proposal of accept#RateProposals or reject#RateProposals, locked with its organization. Refuses a
            user without finance administration, another organization's proposal and one decided already.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="rateProposalId" required="true"/>
            <parameter name="accept" type="Boolean" required="true"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="uomConversionId"/>
        </out-parameters>
        <actions>
            <set field="uomConversionId" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/Currencies.js')
                    .execute('decideProposal', context).uomConversionId"/>
        </actions>
    </service>
    <service verb="get" noun="ImportResult" allow-remote="false">
        <description>Read the results of the user's own currency rate import. Refuses a user without finance
            administration and an import of another user or organization.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="importId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="importId"/>
            <parameter name="results" type="List"/>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="scope" from="ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingPolicy.js')
                    .organization(context, 'admin')"/>
            <entity-find-one entity-name="mantle.ledger.config.CurrencyRateImport" value-field="rateImport"
                    disable-authz="true">
                <field-map field-name="importId"/>
            </entity-find-one>
            <set field="ownImport" from="rateImport?.organizationPartyId === scope.organizationPartyId &amp;&amp;
                    rateImport?.userId === ec.user.userId"/>
            <if condition="!ownImport">
                <return error="true" message="Open your own rate import result"/>
            </if>
            <set field="results" from="JSON.parse(rateImport.resultJson)"/>
            <set field="complete" from="results.every(result => result.success)"/>
        </actions>
    </service>
</services>
